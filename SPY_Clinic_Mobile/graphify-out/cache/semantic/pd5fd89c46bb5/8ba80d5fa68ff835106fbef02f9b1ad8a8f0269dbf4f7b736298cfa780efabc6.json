{"nodes": [{"id": "agents_skills_react_best_practices_rules_rerender_memo_with_default_value_extract_default_non_primitive_parameter_value", "label": "Extract Default Non-primitive Parameter Value from Memoized Component to Constant", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/rerender-memo-with-default-value.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A default array/function/object created inline inside a memoized component is a new instance on every rerender and fails the strict equality comparison used by memo(), breaking memoization. Hoisting the default to a module-level constant restores it."}, {"id": "agents_skills_react_best_practices_rules_rerender_memo_with_default_value_useravatar", "label": "UserAvatar", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/rerender-memo-with-default-value.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_rerender_memo_with_default_value_noop", "label": "NOOP", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/rerender-memo-with-default-value.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agents_skills_react_best_practices_rules_rerender_memo_with_default_value_extract_default_non_primitive_parameter_value", "target": "agents_skills_react_best_practices_rules_rerender_memo_with_default_value_useravatar", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/rerender-memo-with-default-value.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_rerender_memo_with_default_value_extract_default_non_primitive_parameter_value", "target": "age