{"nodes": [{"id": "agents_skills_eas_app_stores_references_app_store_metadata", "label": "App Store Metadata Reference", "file_type": "document", "source_file": ".agents/skills/eas-app-stores/references/app-store-metadata.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_eas_app_stores_references_app_store_metadata_eas_metadata", "label": "EAS Metadata and store.config.json", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/app-store-metadata.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EAS Metadata automates App Store presence management from the command line using a store.config.json file instead of manually filling forms in App Store Connect, and includes built-in validation to catch common rejection pitfalls. Current status: Preview, Apple App Store only."}, {"id": "agents_skills_eas_app_stores_references_app_store_metadata_app_store_optimization", "label": "App Store Optimization (ASO)", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/app-store-metadata.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The title is the most important ranking factor, so the brand name plus one or two strongest keywords go first; the subtitle carries the value proposition without duplicating title words, and the 100-character keyword field uses every character with no spaces after commas."}, {"id": "agents_skills_eas_app_stores_references_app_store_metadata_app_store_release_strategy", "label": "App Store Release Strategy", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/app-store-metadata.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "automaticRelease controls whether release happens on approval, manually, or at an RFC 3339 date, and phasedRelease gives a 7-day gradual rollout (1%, 2%, 5%, 10%, 20%, 50%, 100%) so a bad release can be caught early."}, {"id": "agents_skills_eas_app_stores_references_app_store_metadata_app_store_localization", "label": "App Store Localization", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/app-store-metadata.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Metadata is localized per target market with a fixed set of supported locales, and keywords should be researched per locale because direct translations often miss regional search terms."}, {"id": "agents_skills_eas_app_stores_references_app_store_metadata_app_store_dynamic_configuration", "label": "Dynamic store.config.js Configuration", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/app-store-metadata.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JavaScript configuration allows dynamic values such as a copyright year, fetched translations from a CMS, or environment-specific promo text; eas.json points cli.metadataPath at store.config.js. Note that eas metadata:pull creates a JSON file, so it does not update a JS config automatically."}, {"id": "agents_skills_eas_app_stores_references_app_store_metadata_app_store_age_rating_advisory", "label": "Age Rating Advisory", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/app-store-metadata.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Content questions must be answered honestly to get an appropriate age rating, using the NONE / INFREQUENT_OR_MILD / FREQUENT_OR_INTENSE descriptors plus boolean flags such as gambling, unrestrictedWebAccess and seventeenPlus."}, {"id": "agents_skills_eas_app_stores_references_app_store_metadata_app_store_review_information", "label": "App Review Information", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/app-store-metadata.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The review block provides contact info and demo credentials so the App Review team can actually exercise login-gated features; missing demo accounts are a listed rejection reason."}], "edges": [{"source": "agents_skills_eas_app_stores_references_app_store_metadata", "target": "agents_skills_eas_app_stores_references_app_store_metadata_eas_metadata", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-app-stores/references/app-store-metadata.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_app_stores_references_app_store_metadata", "target": "agents_skills_eas_app_stores_references_app_store_metadata_app_store_optimization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-app-stores/references/app-store-metadata.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_app_stores_references_app_store_metadata", "target": "agents_skills_eas_app_stores_references_app_store_metadata_app_store_release_strategy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-app-stores/references/app-store-metadata.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_app_stores_references_app_store_metadata", "target": "agents_skills_eas_app_stores_references_app_store_metadata_app_store_localization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-app-stores/references/app-store-metadata.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_app_stores_references_app_store_metadata", "target": "agents_skills_eas_app_stores_references_app_store_metadata_app_store_dynamic_configuration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-app-stores/references/app-store-metadata.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_app_stores_references_app_store_metadata", "target": "agents_skills_eas_app_stores_references_app_store_metadata_app_store_age_rating_advisory", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-app-stores/references/app-store-metadata.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_app_stores_references_app_store_metadata", "target": "agents_skills_eas_app_stores_references_app_store_metadata_app_store_review_information", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-app-stores/references/app-store-metadata.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_app_stores_references_app_store_metadata_app_store_dynamic_configuration", "target": "agents_skills_eas_app_stores_references_app_store_metadata_eas_metadata", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-app-stores/references/app-store-metadata.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_app_stores_references_app_store_metadata_app_store_review_information", "target": "agents_skills_eas_app_stores_references_ios_app_store_ios_app_review_process", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".agents/skills/eas-app-stores/references/app-store-metadata.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_app_stores_references_app_store_metadata_app_store_optimizati