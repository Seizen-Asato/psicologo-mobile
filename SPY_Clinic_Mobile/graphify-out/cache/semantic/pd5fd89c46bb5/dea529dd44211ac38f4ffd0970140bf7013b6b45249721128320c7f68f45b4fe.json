{"nodes": [{"id": "agents_skills_react_best_practices_rules_rerender_use_deferred_value_use_deferred_value_for_expensive_derived_renders", "label": "Use useDeferredValue for Expensive Derived Renders", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/rerender-use-deferred-value.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The deferred value lags behind the input so React can prioritize the urgent input update and render the expensive result when idle, keeping the input responsive during heavy filtering or visualization work. The expensive computation must also be wrapped in useMemo keyed on the deferred value."}, {"id": "agents_skills_react_best_practices_rules_rerender_use_deferred_value_search", "label": "Search", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/rerender-use-deferred-value.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_rerender_use_deferred_value_resultslist", "label": "ResultsList", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/rerender-use-deferred-value.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_rerender_use_deferred_value_fuzzymatch", "label": "fuzzyMatch", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/rerender-use-deferred-value.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_rerender_use_deferred_value_use_deferred_value_reference", "label": "React useDeferredValue reference (react.dev)", "file_type": "document", "source_file": ".agents/skills/react-best-practices/rules/rerender-use-deferred-value.md", "sour