{"nodes": [{"id": "agents_skills_react_best_practices_rules_rerender_derived_state_no_effect", "label": "Calculate Derived State During Rendering", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/rerender-derived-state-no-effect.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A value computable from current props/state should be derived during render instead of stored in state and updated in an effect, which otherwise causes extra renders and state drift; derived values or keyed resets are preferred over setState in effects."}, {"id": "agents_skills_react_best_practices_rules_rerender_derived_state_no_effect_form", "label": "Form", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/rerender-derived-state-no-effect.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_rerender_derived_state_no_effect_you_might_not_need_an_effect", "label": "You Might Not Need an Effect", "file_type": "document", "source_file": ".agents/skills/react-best-practices/rules/rerender-derived-state-no-effect.md", "source_location": null, "source_url": "https://react.dev/learn/you-might-not-need-an-effect", "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agents_skills_react_best_practices_rules_rerender_derived_state_no_effect", "target": "agents_skills_react_best_practices_rules_rerender_derived_state_no_effect_form", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/rerender-derived-state-no-effect.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_rerender_derived_state_no_effect", "target": "agents_skills_react_best_practices_rules_rerender_derived_state_no_effect_you_might_not_n