{"nodes": [{"id": "agents_skills_expo_native_ui_skill", "label": "Expo Native UI Guidelines", "file_type": "document", "source_file": ".agents/skills/expo-native-ui/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_expo_native_ui_skill_expo_go_first", "label": "Expo Go First Strategy", "file_type": "rationale", "source_file": ".agents/skills/expo-native-ui/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Custom builds add complexity, slow iteration and require Xcode or Android Studio setup, so Expo Go is tried first and custom builds are created only when a feature truly demands native code."}, {"id": "agents_skills_expo_native_ui_skill_custom_build_requirements", "label": "Custom Build Requirements", "file_type": "rationale", "source_file": ".agents/skills/expo-native-ui/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Custom native builds are reserved for local Expo modules, Apple targets, third-party native modules and native configuration that cannot be expressed in app.json."}, {"id": "agents_skills_expo_native_ui_skill_library_preferences", "label": "Expo Library Preferences", "file_type": "concept", "source_file": ".agents/skills/expo-native-ui/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_expo_native_ui_skill_semantic_color_api", "label": "Semantic Color API", "file_type": "rationale", "source_file": ".agents/skills/expo-native-ui/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The expo-router Color wrapper over PlatformColor resolves platform-native colors on device and auto-adapts to light/dark and accessibility settings, eliminating separate light/dark hex tables."}, {"id": "agents_skills_expo_native_ui_skill_content_inset_adjustment", "label": "Content Inset Adjustment Behavior", "file_type": "concept", "source_file": ".agents/skills/expo-native-ui/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_expo_native_ui_skill_four_state_data_loading", "label": "Four-State Data Loading", "file_type": "rationale", "source_file": ".agents/skills/expo-native-ui/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every data-loading screen has explicit loading, error, empty and content states; showing the empty state while the first load is still resolving misleads the user."}, {"id": "agents_skills_expo_native_ui_skill_platform_design_language", "label": "Platform Design Language Adherence", "file_type": "rationale", "source_file": ".agents/skills/expo-native-ui/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each platform keeps its own design language (Apple HIG on iOS, Material 3 on Android) so the app never dresses one platform in the other platform's uniform."}, {"id": "agents_skills_expo_native_ui_skill_box_shadow_styling", "label": "CSS boxShadow Styling", "file_type": "concept", "source_file": ".agents/skills/expo-native-ui/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_expo_native_ui_skill_prefers_expo_ui", "label": "Prefer @expo/ui Components", "file_type": "rationale", "source_file": ".agents/skills/expo-native-ui/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "@expo/ui renders real SwiftUI and Jetpack Compose with platform design conventions and works in Expo Go, so it is checked before React Native buil