{"nodes": [{"id": "docs_tanstackquery", "label": "TanStack Query Guide", "file_type": "document", "source_file": "docs/TanStackQuery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_tanstackquery_usequery", "label": "useQuery", "file_type": "concept", "source_file": "docs/TanStackQuery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "useQuery is the declarative read hook: it runs queryFn on mount without useEffect or useState, caches the result by queryKey so a second component asking for the same key does not refetch, and exposes isPending/isError/isFetching/isStale/data/refetch plus 3 retries with exponential backoff by default."}, {"id": "docs_tanstackquery_usemutation", "label": "useMutation", "file_type": "concept", "source_file": "docs/TanStackQuery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "useMutation is the imperative write hook: it wraps an async mutationFn and runs it on demand through mutate()/mutateAsync(), does not share cached results between instances and does not retry by default, so a write must be followed by an explicit cache invalidation for readers to see the new state."}, {"id": "docs_tanstackquery_usequeryclient", "label": "useQueryClient", "file_type": "concept", "source_file": "docs/TanStackQuery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "useQueryClient exposes programmatic access to the cache (getQueryData, setQueryData, invalidateQueries) so any part of the application can force a refresh without prop drilling."}, {"id": "docs_tanstackquery_queryclient", "label": "QueryClient", "file_type": "concept", "source_file": "docs/TanStackQuery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "QueryClient is the central server-state manager and cache engine: it owns cache storage and organisation, the data lifecycle (refetch on reconnect/focus/interval, retry handling, garbage collection) and UI synchronisation without prop drilling."}, {"id": "docs_tanstackquery_querykey", "label": "queryKey", "file_type": "concept", "source_file": "docs/TanStackQuery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "queryKey is the unique cache identifier: the same key means the same cache entry, which is what makes deduplicated fetching and targeted invalidation possible."}, {"id": "docs_tanstackquery_cache_invalidation_flow", "label": "Cache Invalidation Flow", "file_type": "concept", "source_file": "docs/TanStackQuery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The typical flow closes the loop between the three hooks: useQuery fetches and caches, useMutation sends the modification, and useQueryClient's invalidateQueries marks the cache stale so useQuery refetches automatically."}, {"id": "docs_tanstackquery_optimistic_updates", "label": "Optimistic Updates (onMutate)", "file_type": "concept", "source_file": "docs/TanStackQuery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "onMutate fires before the request is sent, so the UI updates instantly and reverts if the server rejects the change; this is the only supported optimistic-update path because useQuery has no equivalent."}, {"id": "docs_tanstackquery_mutation_callbacks", "label": "Mutation Lifecycle Callbacks", "file_type": "concept", "source_file": "docs/TanStackQuery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_tanstackquery_query_options", "label": "Key Query Options (queryKey, enabled, staleTime, refetchInterval, select, placeholderData)", "file_type": "concept", "source_file": "docs/TanStackQuery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_tanstackquery_garbage_collection", "label": "Garbage Collection", "file_type": "concept", "source_file": "docs/TanStackQuery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_tanstackquery_retry_and_backoff", "label": "Retry and Exponential Backoff", "file_type": "concept", "source_file": "docs/TanStackQuery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_tanstackquery", "target": "docs_tanstackquery_usequery", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/TanStackQuery.md", "source_location": null, "weight": 1.0}, {"source": "docs_tanstackquery", "target": "docs_tanstackquery_usemutation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/TanStackQuery.md", "source_location": null, "weight": 1.0}, {"source": "docs_tanstackquery", "target": "docs_tanstackquery_usequeryclient", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/TanStackQuery.md", "source_location": null, "weight": 1.0}, {"source": "docs_tanstackquery", "target": "docs_tanstackquery_cache_invalidation_flow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/TanStackQuery.md", "source_location": null, "weight": 1.0}, {"source": "docs_tanstackquery_usequeryclient", "target": "docs_tanstackquery_queryclient", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/TanStackQuery.md", "source_location": null, "weight": 1.0}, {"source": "docs_tanstackquery_queryclient", "target": "docs_tanstack