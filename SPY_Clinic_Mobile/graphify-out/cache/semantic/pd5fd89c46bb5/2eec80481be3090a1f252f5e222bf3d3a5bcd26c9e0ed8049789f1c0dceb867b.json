{"nodes": [{"id": "agents_skills_react_best_practices_rules_rendering_animate_svg_wrapper", "label": "Animate SVG Wrapper Instead of SVG Element", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/rendering-animate-svg-wrapper.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Many browsers do not hardware-accelerate CSS3 animations applied to SVG elements; wrapping the SVG in a div and animating the wrapper allows GPU acceleration for transforms, opacity, translate, scale and rotate."}, {"id": "agents_skills_react_best_practices_rules_rendering_animate_svg_wrapper_loadingspinner", "label": "LoadingSpinner", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/rendering-animate-svg-wrapper.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_rendering_animate_svg_wrapper_hardware_acceleration", "label": "Browser GPU Hardware Acceleration", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/rendering-animate-svg-wrapper.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agents_skills_react_best_practices_rules_rendering_animate_svg_wrapper", "target": "agents_skills_react_best_practices_rules_rendering_animate_svg_wrapper_hardware_acceleration", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/rendering-animate-svg-wrapper.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_rendering_animate_svg_wrapper", "target": "agents_skills_react_best_practices_rules_rendering_animate_svg_wrapper_loadingspinner", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "sourc