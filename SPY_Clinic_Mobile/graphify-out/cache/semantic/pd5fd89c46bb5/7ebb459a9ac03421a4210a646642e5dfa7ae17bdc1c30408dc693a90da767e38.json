{"nodes": [{"id": "agents_skills_design_mobile_apps_designing", "label": "Designing with Sleek (Workflow)", "file_type": "document", "source_file": ".agents/skills/design-mobile-apps/designing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_design_mobile_apps_designing_style_direction", "label": "Authoring a Style Direction", "file_type": "rationale", "source_file": ".agents/skills/design-mobile-apps/designing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A style direction is a single comprehensive paragraph covering mood, color strategy, typography feel, layout philosophy, component style, imagery and one or two distinctive details; anything that only sets a mood reads as a hint rather than a direction. Personality belongs in color, type and imagery rather than unusual layout or navigation, and a style direction must not be combined with a referenceId because the reference already carries a full style guide."}, {"id": "agents_skills_design_mobile_apps_designing_chat_run_polling", "label": "Chat Run Polling Protocol", "file_type": "rationale", "source_file": ".agents/skills/design-mobile-apps/designing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs are async: poll from 2s and back off to 5s after 10s, for up to 10 minutes, exiting only on completed or failed. Elapsed time does not prove completion and does not release the project run lock, so a new attempt must not start while the previous outcome is unknown."}, {"id": "agents_skills_design_mobile_apps_designing_safe_retries", "label": "Safe Retries with Idempotency Keys", "file_type": "rationale", "source_file": ".agents/skills/design-mobile-apps/designing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Choose an idempotency-key before sending so a lost response can be replayed with the same payload and key to recover the original run. After request_message_persist_failed or after the user resolves out_of_credits, a new logical attempt needs a new key."}, {"id": "agents_skills_design_mobile_apps_designing_one_run_at_a_time", "label": "One Active Run per Project", "file_type": "rationale", "source_file": ".agents/skills/design-mobile-apps/designing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep one active run per project and follow a known run to a terminal status before sending the next message. A 409 carries no active-run pointer and the API has no run-list endpoint, so an unknown run ID must be reported rather than invented."}, {"id": "agents_skills_design_mobile_apps_designing_screenshot_loop", "label": "Screenshot Review Loop", "file_type": "rationale", "source_file": ".agents/skills/design-mobile-apps/designing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After every run producing screen_created or screen_updated operations, take screenshots and show them to the user. The phone-shaped user shot is the right framing for showing a screen but the wrong one for judging it, because everything below the fold is cropped away; use the full-height review shot for self-review and check the component HTML before reporting content as missing."}, {"id": "agents_skills_design_mobile_apps_designing_user_shot_review_shot", "label": "User Shot vs Review Shot", "file_type": "concept", "source_file": ".agents/skills/design-mobile-apps/designing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agents_skills_design_mobile_apps_designing", "target": "agents_skills_design_mobile_apps_endpoints", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/design-mobile-apps/designing.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_design_mobile_apps_designing", "target": "agents_skills_design_mobile_apps_implementing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/design-mobile-apps/designing.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_design_mobile_apps_designing", "target": "agents_skills_design_mobile_apps_designing_style_direction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/design-mobile-apps/designing.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_design_mobile_apps_designing", "target": "agents_skills_design_mobile_apps_designing_chat_run_polling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/design-mobile-apps/designing.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_design_mobile_apps_designing", "target": "agents_skills_design_mobile_apps_designing_safe_retries", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/design-mobile-apps/designing.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_design_mobile_apps_designing", "target": "agents_skills_design_mobile_apps_designing_one_run_at_a_time", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/design-mobile-apps/designing.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_design_mobile_apps_designing", "target": "agents_skills_design_mobile_apps_designing_screenshot_loop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/design-mobile-apps/designing.md", "source_location": null, "weight": 1.0}, {"sourc