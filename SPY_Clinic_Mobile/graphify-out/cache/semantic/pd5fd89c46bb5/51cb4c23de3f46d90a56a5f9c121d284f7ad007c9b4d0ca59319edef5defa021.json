{"nodes": [{"id": "agents_skills_react_best_practices_rules_bundle_dynamic_imports_dynamic_imports_for_heavy_components", "label": "Dynamic Imports for Heavy Components", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/bundle-dynamic-imports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lazy-loading large components that are not needed on the first render keeps them out of the main chunk, directly improving TTI and LCP (Monaco alone is ~300KB of main bundle)."}, {"id": "agents_skills_react_best_practices_rules_bundle_dynamic_imports_next_dynamic", "label": "next/dynamic", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/bundle-dynamic-imports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Component-level lazy loading API; with { ssr: false } the underlying module is fetched only on the client when the component actually renders."}, {"id": "agents_skills_react_best_practices_rules_bundle_dynamic_imports_dynamic_import", "label": "Dynamic import() code splitting", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/bundle-dynamic-imports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "import() splits a module into its own chunk that is fetched on demand instead of being pulled into the initial module graph."}, {"id": "agents_skills_react_best_practices_rules_bundle_dynamic_imports_codepanel", "label": "CodePanel (heavy component consumer)", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/bundle-dynamic-imports.md", "source_location": "L17-L20, L32-L34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "agents_skills_react_best_practices_rules_bundle_dynamic_imports