{"nodes": [{"id": "agents_skills_react_best_practices_rules_js_batch_dom_css_avoid_layout_thrashing", "label": "Avoid Layout Thrashing", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/js-batch-dom-css.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Interleaving style writes with layout reads forces a synchronous reflow on every read; batching all writes before the read (or all reads before the writes) limits the browser to a single recalculation, and CSS classes are preferred over inline styles because stylesheets are cached by the browser."}, {"id": "agents_skills_react_best_practices_rules_js_batch_dom_css_layout_thrashing", "label": "Layout Thrashing (forced synchronous reflow)", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/js-batch-dom-css.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reading offsetWidth, offsetHeight, getBoundingClientRect or getComputedStyle between style writes invalidates layout and forces the browser to recalculate synchronously, blocking the main thread."}, {"id": "agents_skills_react_best_practices_rules_js_batch_dom_css_updateelementstyles", "label": "updateElementStyles (batched style write)", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/js-batch-dom-css.md", "source_location": "L14-L21, L35-L45, L71-L75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "agents_skills_react_best_practices_rules_js_batch_dom_css_avoidthrashing", "label": "avoidThrashing (read-then-write batching)", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/js-batch-dom-css.md", "source_location": "L49-L58", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "agents_skills_