{"nodes": [{"id": "agents_skills_seo_skill", "label": "SEO Optimization Skill", "file_type": "document", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null}, {"id": "agents_skills_seo_skill_evidence_led_audit_workflow", "label": "Evidence-Led Audit Workflow", "file_type": "rationale", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null, "rationale": "A Lighthouse SEO score covers only a useful subset of technical checks and is not a prediction of rankings. The workflow therefore separates technical crawl/index findings from content quality and authority, forbids inventing ranking-factor weights, and requires re-running the same checks after fixing the source, reporting indexation outcomes as still pending search-engine validation."}, {"id": "agents_skills_seo_skill_technical_seo", "label": "Technical SEO", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null}, {"id": "agents_skills_seo_skill_crawlability", "label": "Crawlability", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null, "rationale": "robots.txt must not block resources the crawler needs in order to render the page (e.g. Disallow: /static/ blocks rendering assets), so crawl directives must be audited against the page's own resource needs."}, {"id": "agents_skills_seo_skill_robots_txt", "label": "robots.txt Directives", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null}, {"id": "agents_skills_seo_skill_meta_robots", "label": "Meta Robots Directives", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null}, {"id": "agents_skills_seo_skill_canonical_urls", "label": "Canonical URLs", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null, "rationale": "A self-referencing canonical is recommended so duplicate content issues are prevented, and canonical consistency across page templates is one of the signals Lighthouse cannot establish on its own."}, {"id": "agents_skills_seo_skill_xml_sitemap", "label": "XML Sitemap", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null, "rationale": "A single sitemap is capped at 50,000 URLs or 50MB, so larger sites need a sitemap index; only canonical, indexable URLs belong in the sitemap and lastmod must be updated when content changes."}, {"id": "agents_skills_seo_skill_url_structure", "label": "URL Structure", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null}, {"id": "agents_skills_seo_skill_https_and_security", "label": "HTTPS and Security Headers", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null}, {"id": "agents_skills_seo_skill_on_page_seo", "label": "On-Page SEO", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null}, {"id": "agents_skills_seo_skill_title_tags", "label": "Title Tags", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null, "rationale": "The 50-60 character rule is only a rough linting proxy, not a pass/fail limit: Google truncates title links to fit the rendered device width and may build a different title link from the visible title, headings and anchor text, so title-link rewriting must be treated separately from truncation."}, {"id": "agents_skills_seo_skill_meta_descriptions", "label": "Meta Descriptions", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null, "rationale": "The 150-160 character range is only a linting proxy because snippets are query- and device-dependent and Google may select page content instead of the meta description."}, {"id": "agents_skills_seo_skill_heading_structure", "label": "Heading Structure", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null, "rationale": "The primary page heading must be descriptive and the hierarchy unambiguous, but a page should not fail solely because valid HTML contains more than one h1."}, {"id": "agents_skills_seo_skill_image_seo", "label": "Image SEO", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null}, {"id": "agents_skills_seo_skill_internal_linking", "label": "Internal Linking", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null}, {"id": "agents_skills_seo_skill_structured_data", "label": "Structured Data (JSON-LD)", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null, "rationale": "Schema markup must describe visible, accurate content using the most specific applicable type; a type or claim should never be added solely to obtain a rich result, and passing syntax validation does not guarantee search-engine eligibility or display."}, {"id": "agents_skills_seo_skill_agentic_browsing", "label": "Agentic Browsing and AI Discoverability", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null, "rationale": "Lighthouse Agentic Browsing measures technical signals that help an assistant read and interact with a rendered page (accessibility tree, optional llms.txt, WebMCP registrations). It is deliberately kept separate from search indexing/ranking and from AI ingestion/citation, because a browsable page or a valid llms.txt does not prove any AI product will ingest, rank or cite the content."}, {"id": "agents_skills_seo_skill_crawler_controls", "label": "Product-Specific Crawler Controls", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null, "rationale": "Crawler controls are audited per documented user agent instead of a blanket AI-bot rule, because training controls (GPTBot, ClaudeBot) are distinct from search and user-fetch controls (OAI-SearchBot, PerplexityBot, Claude-SearchBot, Claude-User) and Google-Extended affects Gemini training/grounding rather than Google Search inclusion or ranking."}, {"id": "agents_skills_seo_skill_llms_txt", "label": "llms.txt (Optional)", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null, "rationale": "llms.txt is an experimental proposal, not a cross-vendor discovery standard. It is added only on request or when a documented consumer supports it, and must never be treated as a ranking or citation factor, duplicated from the sitemap, or used to reorganize content solely to raise the audit."}, {"id": "agents_skills_seo_skill_mobile_seo", "label": "Mobile SEO", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null}, {"id": "agents_skills_seo_skill_responsive_design", "label": "Responsive Design (Viewport)", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null}, {"id": "agents_skills_seo_skill_tap_targets", "label": "Tap Targets", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null, "rationale": "Mobile links need at least 48x48px hit areas and readable 16px font sizes so users can interact and read without zooming."}, {"id": "agents_skills_seo_skill_font_sizes", "label": "Font Sizes", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null}, {"id": "agents_skills_seo_skill_international_seo", "label": "International SEO", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null}, {"id": "agents_skills_seo_skill_hreflang_tags", "label": "Hreflang Tags", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null}, {"id": "agents_skills_seo_skill_language_declaration", "label": "Language Declaration (html lang)", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null}, {"id": "agents_skills_seo_skill_seo_audit_checklist", "label": "SEO Audit Checklist", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null}, {"id": "agents_skills_seo_skill_tools", "label": "SEO Audit Tools", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null}, {"id": "agents_skills_seo_skill_lighthouse_audit", "label": "Lighthouse SEO Audit", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null}, {"id": "agents_skills_seo_skill_core_web_vitals", "label": "Core Web Vitals", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null}, {"id": "agents_skills_seo_skill_schema_org", "label": "Schema.org Vocabulary", "file_type": "concept", "source_file": ".agents/skills/seo/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "web-quality-skills", "contributor": null}, {"id": "agents_skills_seo_skill_google_rich_results_test", "label": "Google Rich Results Test", "file_type": "concept", "source_file": ".agents/skills/seo/