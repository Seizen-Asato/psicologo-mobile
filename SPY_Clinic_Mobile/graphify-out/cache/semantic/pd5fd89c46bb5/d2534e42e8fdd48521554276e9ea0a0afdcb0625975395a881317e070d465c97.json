{"nodes": [{"id": "agents_skills_react_best_practices_rules_server_cache_lru_cross_request_lru_caching", "label": "Cross-Request LRU Caching", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/server-cache-lru.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React.cache() only deduplicates within a single request, so sequential user actions that need the same data across requests require a cross-request LRU cache. Vercel Fluid Compute shares one function instance across concurrent requests so the cache persists without Redis; traditional serverless needs an external cache."}, {"id": "agents_skills_react_best_practices_rules_server_cache_lru_getuser", "label": "getUser", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/server-cache-lru.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_server_cache_lru_lrucache", "label": "LRUCache", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/server-cache-lru.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_server_cache_lru_node_lru_cache", "label": "node-lru-cache (GitHub)", "file_type": "document", "source_file": ".agents/skills/react-best-practices/rules/server-cache-lru.md", "source_location": null, "source_url": "https://github.com/isaacs/node-lru-cache", "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_server_cache_lru_fluid_compute", "label": "Vercel Fluid Compute documentation", "file_type": "document", "source_file": ".agents/skills/react-best-practices/rules/server-cache-lru.md", "source_location": null, "source_url": "https://vercel.com/docs/fluid-compute", "captured_at": null, "auth