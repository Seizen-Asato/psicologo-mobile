{"nodes": [{"id": "agents_skills_react_best_practices_rules_server_cache_react_per_request_deduplication_with_react_cache", "label": "Per-Request Deduplication with React.cache()", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/server-cache-react.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React.cache() memoizes by shallow (Object.is) equality within a request, so inline object arguments always miss the cache. It is essential for database queries, heavy computations, authentication checks and file system operations that are not covered by the automatic fetch request memoization in Next.js."}, {"id": "agents_skills_react_best_practices_rules_server_cache_react_react_cache", "label": "React.cache()", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/server-cache-react.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React.cache() deduplicates calls only within the scope of a single request; its scope limitation is what motivates cross-request LRU caching."}, {"id": "agents_skills_react_best_practices_rules_server_cache_react_getcurrentuser", "label": "getCurrentUser", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/server-cache-react.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_server_cache_react_getuser", "label": "getUser", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/server-cache-react.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_server_cache_react_react_cache_reference", "label": "React.cache reference (react.dev)", "file_type": "document", "source_file": ".agents/skills/react-best-practices/rules/server-cache-react.md", "source_location": null, "source_url": "https://react.dev/reference/react/cache", "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_server_cache_react_nextjs_fetch_request_memoization", "label": "Next.js fetch request memoization", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/server-cache-react.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Next.js extends fetch with automatic request memoization, so identical URLs and options are already deduplicated within a request and do not need React.cache()."}], "edges": [{"source": "agents_skills_react_best_practices_rules_server_cache_react_per_request_deduplication_with_react_cache", "target": "agents_skills_react_best_practices_rules_server_cache_react_react_cache", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/server-cache-react.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_server_cache_react_per_request_deduplication_with_react_cache", "target": "agents_skills_react_best_practices_rules_server_cache_react_react_cache_reference", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/server-cache-react.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_server_cache_react_per_request_deduplication_with_react_cache", "target": "agents_skills_react_best_practices_rules_server_cache_react_nextjs_fetch_request_memoization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/server-cache-react.md", "source_location": null, "weight": 1.0}, {"source": "agent