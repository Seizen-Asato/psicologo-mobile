{"nodes": [{"id": "agents_skills_react_best_practices_rules_advanced_use_latest_useeffectevent_for_stable_callback_refs", "label": "useEffectEvent for Stable Callback Refs", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/advanced-use-latest.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accessing the latest values inside callbacks without adding them to dependency arrays prevents effect re-runs while avoiding stale closures."}, {"id": "agents_skills_react_best_practices_rules_advanced_use_latest_useeffectevent", "label": "useEffectEvent (React hook)", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/advanced-use-latest.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns a stable function identity that always invokes the latest version of the wrapped handler, so effects can read fresh values without listing them as dependencies."}, {"id": "agents_skills_react_best_practices_rules_advanced_use_latest_searchinput", "label": "SearchInput (debounced search example)", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/advanced-use-latest.md", "source_location": "L15-L38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "agents_skills_react_best_practices_rules_advanced_use_latest_stale_closure", "label": "Stale Closure", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/advanced-use-latest.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Callbacks capture the props and state of the render that created them, so they keep reading outdated values after state changes unless the callback identity or the update form is made stable."}], "edges": [{"source": "agents_skills_r