{"nodes": [{"id": "agents_skills_react_best_practices_rules_js_tosorted_immutable", "label": "Use toSorted() Instead of sort() for Immutability", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/js-tosorted-immutable.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ".sort() mutates the array in place, which breaks React's immutability model for props and state and causes stale closure bugs; .toSorted() returns a new sorted array without mutation."}, {"id": "agents_skills_react_best_practices_rules_js_tosorted_immutable_tosorted", "label": "toSorted", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/js-tosorted-immutable.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_js_tosorted_immutable_immutable_array_methods", "label": "Immutable Array Methods (toSorted, toReversed, toSpliced, with)", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/js-tosorted-immutable.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_js_tosorted_immutable_userlist", "label": "UserList", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/js-tosorted-immutable.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_js_tosorted_immutable_react_immutability_model", "label": "React Props/State Immutability Model", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/js-tosorted-immutable.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React expects props and state to be treated as read-only, so in-place mutation of a prop array both violates the model and produces stale closures when done inside callbacks or effects."}], "edges": [{"source": "agents_skills_react_best_practices_rules_js_tosorted_immutable", "target": "agents_skills_react_best_practices_rules_js_tosorted_immutable_tosorted", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/js-tosorted-immutable.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_js_tosorted_immutable", "target": "agents_skills_react_best_practices_rules_js_tosorted_immutable_immutable_array_methods", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/js-tosorted-immutable.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_js_tosorted_immutable", "target": "agents_skills_react_best_practices_rules_js_tosorted_immutable_react_immutability_model", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/js-tosorted-immutable.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_js_tosorted_immutable_userlist", "target": "agents_skills_react_best_practices_rules_js_tosorted_immutable_tosorted", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/js-tosorted-immutable.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_js_tosorted_immutable_userlist", "target": "agents_skills_react_best_practices_rules_js_tosorted_immutable_react_immutability_model", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/