{"nodes": [{"id": "agents_skills_react_best_practices_rules_server_parallel_fetching_parallel_data_fetching_with_component_composition", "label": "Parallel Data Fetching with Component Composition", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/server-parallel-fetching.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React Server Components execute sequentially within a tree, so a sibling component's await blocks its siblings. Restructuring the tree with composition (or a children prop) lets each component fetch in parallel and eliminates server-side waterfalls."}, {"id": "agents_skills_react_best_practices_rules_server_parallel_fetching_page", "label": "Page", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/server-parallel-fetching.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_server_parallel_fetching_header", "label": "Header", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/server-parallel-fetching.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_server_parallel_fetching_sidebar", "label": "Sidebar", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/server-parallel-fetching.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_server_parallel_fetching_layout", "label": "Layout", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/server-parallel-fetching.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_server_par