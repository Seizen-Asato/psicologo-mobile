{"nodes": [{"id": "agents_skills_react_best_practices_rules_bundle_barrel_imports_avoid_barrel_file_imports", "label": "Avoid Barrel File Imports", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/bundle-barrel-imports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Barrel entry points can expose thousands of re-exports (up to 10,000), costing 200-800ms per cold start; importing from source files or letting Next.js rewrite barrel imports at build time gives 15-70% faster dev boot, 28% faster builds and 40% faster cold starts."}, {"id": "agents_skills_react_best_practices_rules_bundle_barrel_imports_barrel_file", "label": "Barrel File", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/bundle-barrel-imports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An entry point that re-exports multiple modules (e.g. index.js doing export * from './module'); the pattern defeats tree-shaking when the library is external and slows builds substantially when it is bundled."}, {"id": "agents_skills_react_best_practices_rules_bundle_barrel_imports_optimizepackageimports", "label": "Next.js optimizePackageImports", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/bundle-barrel-imports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build-time config that rewrites barrel imports into direct imports, keeping TypeScript type safety and editor autocompletion while eliminating the barrel import cost."}, {"id": "agents_skills_react_best_practices_rules_bundle_barrel_imports_lucide_react", "label": "lucide-react", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/bundle-barrel-imports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Icon library whose entry file re-exports thousands of modules; importing the barrel loads 1,583 modules (~2.8s extra in dev) and it ships no .d.ts for deep import paths, so optimizePackageImports is the safe fix."}, {"id": "agents_skills_react_best_practices_rules_bundle_barrel_imports_mui_material", "label": "@mui/material", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/bundle-barrel-imports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Component library whose barrel entry loads 2,225 modules (~4.2s extra in dev); deep imports such as @mui/material/Button load only what is used."}, {"id": "agents_skills_react_best_practices_rules_bundle_barrel_imports_nextjs_package_imports_blog", "label": "How we optimized package imports in Next.js (Vercel engineering blog)", "file_type": "document", "source_file": ".agents/skills/react-best-practices/rules/bundle-barrel-imports.md", "source_location": null, "source_url": "https://vercel.com/blog/how-we-optimized-package-imports-in-next-js", "captured_at": null, "author": null, "contributor": null, "rationale": "Describes the build-time barrel-import transform behind optimizePackageImports and its measured dev/build/cold-start gains."}], "edges": [{"source": "agents_skills_react_best_practices_rules_bundle_barrel_imports_avoid_barrel_file_imports", "target": "agents_skills_react_best_practices_rules__template_rule_document_template", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".agents/skills/react-best-practices/rules/bundle-barrel-imports.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_bundle_barrel_imports_avoid_barrel_file_imports", "target": "agents_skills_react_best_practices_rules_bundle_barrel_imports_barrel_file", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/bundle-barrel-imports.md", "source_location": "L10", "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_bundle_barrel_imports_avoid_barrel_file_imports", "target": "agents_skills_react_best_practices_rules_bundle_barrel_imports_optimizepackageimports", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/bundle-barrel-imports.md", "source_location": "L31-L35", "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_bundle_barrel_imports_avoid_barrel_file_imports", "target": "agents_skills_react_best_practices_rules_bundle_barrel_imports_lucide_react", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/bundle-barrel-imports.md", "source_location": "L19-L20", "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_bundle_barrel_imports_avoid_barrel_file_imports", "target": "agents_skills_react_best_practices_rules_bundle_barrel_imports_mui_material", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/bundle-barrel-imports.md", "source_location": "L23-L24", "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_bundle_barrel_imports_avoid_barrel_file_imports", "target": "agents_skills_react_best_practices_rules_bundle_barrel_imports_nextjs_package_imports_blog", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/bundle-barrel-imports.md", "source_location": "L60", "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_bundle_barrel_imports_barrel_file", "target": "agents_skills_react_best_practices_rules_bundle_barrel_imports_lucide_react", "relation": "conceptually_related_