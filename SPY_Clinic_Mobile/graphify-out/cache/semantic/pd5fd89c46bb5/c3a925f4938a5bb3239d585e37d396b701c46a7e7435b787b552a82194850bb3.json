{"nodes": [{"id": "agents_skills_composition_patterns_rules_react19_no_forwardref", "label": "React 19 API Changes (no forwardRef, use() over useContext())", "file_type": "rationale", "source_file": ".agents/skills/composition-patterns/rules/react19-no-forwardref.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In React 19 ref is a regular prop so the forwardRef wrapper is dead weight, and use() replaces useContext() with the added benefit that it can be called conditionally. The rule is React 19+ only and should be skipped on React 18 or earlier."}], "edges": [{"source": "agents_skills_composition_patterns_rules_react19_no_forwardref", "target": "agents_skills_composition_patterns_rules_state_context_interface", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/composition-patterns/rules/react19-no-forwardref.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_composition_patterns_rules_react19_no_forwardref", "target": "agents_skills_composition_patterns_agents_react19_use", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/composition-patterns/rules/react19-no-forwardref.md", "source_location": null, "weight": 1.0}], "hyperedges": []}