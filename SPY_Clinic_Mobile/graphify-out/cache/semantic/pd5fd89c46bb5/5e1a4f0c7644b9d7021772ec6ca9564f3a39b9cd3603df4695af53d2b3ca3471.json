{"nodes": [{"id": "agents_skills_react_best_practices_rules_server_dedup_props_avoid_duplicate_serialization_in_rsc_props", "label": "Avoid Duplicate Serialization in RSC Props", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/server-dedup-props.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RSC to client serialization deduplicates by object reference rather than value, so transformations that create new references (.toSorted, .filter, .map, .slice, spread) duplicate the payload. Transforming on the client keeps the wire size minimal."}, {"id": "agents_skills_react_best_practices_rules_server_dedup_props_clientlist", "label": "ClientList", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/server-dedup-props.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_server_dedup_props_reference_based_deduplication", "label": "Reference-Based Serialization Deduplication", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/server-dedup-props.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same object reference is serialized once and reused; a new reference is serialized again. Deduplication recurses, so primitive arrays are fully duplicated while nested objects inside object arrays are deduplicated by reference."}], "edges": [{"source": "agents_skills_react_best_practices_rules_server_dedup_props_avoid_duplicate_serialization_in_rsc_props", "target": "agents_skills_react_best_practices_rules_server_dedup_props_clientlist", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/server-dedup-props.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_server_dedup_props_avoid_duplicate_serialization_in_rsc_props", "target": "agents_skills_react_best_practices_rules_server_dedup_props_reference_based_deduplication", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/server-dedup-props.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_server_dedup_props_avoid_duplicate_serialization_in_rsc_props", "target": "agents_skills_react_best_practices_rules_server_serialization_minimize_serialization_at_rsc_boundaries", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".agents/skills/react-best-practices/rules/server-dedup-props.md", "source_location": null, "weight": 1.0}], "hyperedges": []}