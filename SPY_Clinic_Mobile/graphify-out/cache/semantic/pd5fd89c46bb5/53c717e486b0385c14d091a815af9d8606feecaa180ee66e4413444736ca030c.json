{"nodes": [{"id": "agents_skills_react_best_practices_rules_async_parallel_promise_all_for_independent_operations", "label": "Promise.all() for Independent Operations", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/async-parallel.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Awaiting independent operations one after another costs one network round trip each; awaiting them together collapses three round trips into one."}, {"id": "agents_skills_react_best_practices_rules_async_parallel_promise_all", "label": "Promise.all()", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/async-parallel.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Awaits an array of promises concurrently and resolves once all settle; it is the core primitive for removing request waterfalls when operations have no interdependencies."}], "edges": [{"source": "agents_skills_react_best_practices_rules_async_parallel_promise_all_for_independent_operations", "target": "agents_skills_react_best_practices_rules__template_rule_document_template", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".agents/skills/react-best-practices/rules/async-parallel.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_async_parallel_promise_all_for_independent_operations", "target": "agents_skills_react_best_practices_rules_async_parallel_promise_all", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/async-parallel.md", "source_location": "L10", "weight": 1.0}], "hyperedges": []}