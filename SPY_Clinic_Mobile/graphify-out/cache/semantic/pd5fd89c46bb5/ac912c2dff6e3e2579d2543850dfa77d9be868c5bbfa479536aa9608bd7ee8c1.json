{"nodes": [{"id": "agents_skills_design_mobile_apps_styling_stylesheet", "label": "Styling: StyleSheet", "file_type": "document", "source_file": ".agents/skills/design-mobile-apps/styling/stylesheet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_design_mobile_apps_styling_stylesheet_stylesheet_color_token_conversion", "label": "Color Token Conversion to Native Parser", "file_type": "rationale", "source_file": ".agents/skills/design-mobile-apps/styling/stylesheet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React Native's color parser reads hex, rgb() and named colors and carries no oklch matcher, so a raw oklch(...) token resolves to nothing; converting each token once in the token module keeps every consumer correct instead of scattering conversions."}, {"id": "agents_skills_design_mobile_apps_styling_stylesheet_stylesheet_dip_unit_mapping", "label": "Density-Independent Pixel Unit Mapping", "file_type": "rationale", "source_file": ".agents/skills/design-mobile-apps/styling/stylesheet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React Native styles use unitless numbers in density-independent pixels, so Tailwind's 0.25rem spacing steps and rem/em font sizes must be resolved against the HTML root font size; viewport-relative sizes go through useWindowDimensions() and then pass numeric native values."}, {"id": "agents_skills_design_mobile_apps_styling_stylesheet_stylesheet_static_sheet_composition", "label": "Static StyleSheet Composition", "file_type": "rationale", "source_file": ".agents/skills/design-mobile-apps/styling/stylesheet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One StyleSheet.create per component file holds everything static and conditional styling composes with arrays, while values that genuinely change per render (a measured width, an animated height) stay inline."}], "edges": [{"source": "agents_skills_design_mobile_apps_styling_stylesheet", "target": "agents_skills_design_mobile_apps_styling_stylesheet_stylesheet_color_token_conversion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/design-mobile-apps/styling/stylesheet.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_design_mobile_apps_styling_stylesheet", "target": "agents_skills_design_mobile_apps_styling_stylesheet_stylesheet_dip_unit_mapping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/design-mobile-apps/styling/stylesheet.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_design_mobile_apps_styling_stylesheet", "target": "agents_skills_design_mobile_apps_styling_stylesheet_stylesheet_static_sheet_composition", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/design-mobile-apps/styling/stylesheet.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_design_mobile_apps_styling_stylesheet_stylesheet_color_token_conversion", "target": "agents_skills_design_mobile_apps_styling_stylesheet_stylesheet_dip_unit_mapping", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".agents/skills/design-mobile-apps/styling/stylesheet.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_design_mobile_apps_styling_stylesheet_stylesheet_color_token_conversion", "target": "agents_skills_design_mobile_apps_styling_uniwind_uniwind_oklch_support", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.8, "source_file": ".agents/skills/design-mobile-apps/styling/stylesheet.md", "source_location": null, "weight": 1.0}], 