{"nodes": [{"id": "agents_skills_design_mobile_apps_styling_nativewind", "label": "Styling: Nativewind", "file_type": "document", "source_file": ".agents/skills/design-mobile-apps/styling/nativewind.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_design_mobile_apps_styling_nativewind_nativewind_major_compatibility_matrix", "label": "Nativewind Major Compatibility Matrix", "file_type": "rationale", "source_file": ".agents/skills/design-mobile-apps/styling/nativewind.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The two Nativewind lines consume different Tailwind majors (v4 expects Tailwind v3, v5 expects Tailwind v4) and everything else branches on which one is installed, so the resolved version must be read from the lockfile before any styling decision."}, {"id": "agents_skills_design_mobile_apps_styling_nativewind_nativewind_tailwind_v4_to_v3_class_mapping", "label": "Tailwind v4 to v3 Class Mapping", "file_type": "rationale", "source_file": ".agents/skills/design-mobile-apps/styling/nativewind.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A class that resolves to nothing is usually one of a known set of renames (shadow-xs, rounded-xs, outline-hidden, bg-linear-to-b, bg-(--token)); under Nativewind v5 none of the mapping applies, so the installed major decides whether renaming or a different mechanism is needed."}, {"id": "agents_skills_design_mobile_apps_styling_nativewind_nativewind_theme_token_porting", "label": "Theme Token Porting", "file_type": "concept", "source_file": ".agents/skills/design-mobile-apps/styling/nativewind.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "@theme / @theme inline is Tailwind v4 syntax with no v3 equivalent, so under Nativewind v4 tokens must move into theme.extend in tailwind.config.js, which is what makes bg-primary and text-foreground resolve at all; under v5 the @theme block ports to the CSS entry unchanged."}, {"id": "agents_skills_design_mobile_apps_styling_nativewind_nativewind_build_step_checklist", "label": "Nativewind Build Step Checklist", "file_type": "rationale", "source_file": ".agents/skills/design-mobile-apps/styling/nativewind.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A missing build step presents as every class doing nothing at all, silently, so the per-major checklist (Babel preset, Metro wrapper, tailwind.config.js, PostCSS, CSS entry in the root layout) is checked before rewriting any class."}, {"id": "agents_skills_design_mobile_apps_styling_nativewind_nativewind_units_root_font_size", "label": "Root Font Size Units Alignment", "file_type": "rationale", "source_file": ".agents/skills/design-mobile-apps/styling/nativewind.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sleek's default web rem is 16px while Nativewind's native default is 14, so spacing and typography shrink on device despite matching on web; the root size must be aligned per major (inlineRem: 16 for v4, :root font-size for v5) rather than assumed to carry across."}, {"id": "agents_skills_design_mobile_apps_styling_nativewind_nativewind_third_party_class_mapping", "label": "Third-Party Component Class Mapping", "file_type": "concept", "source_file": ".agents/skills/design-mobile-apps/styling/nativewind.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Before passing className to a third-party component such as LinearGradient, check whether it forwards classes to a supported primitive or needs an explicit mapping (cssInterop in v4, a returned styled wrapper in v5); mappings are defined once outside render so the mapped component can be reused and probed."}], "edges": [{"source": "agents_skills_design_mobile_apps_styling_nativewind", "target": "agents_skills_design_mobile_apps_styling_nativewind_nativewind_major_compatibility_matrix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/design-mobile-apps/styling/nativewind.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_design_mobile_apps_styling_nativewind", "target": "agents_skills_design_mobile_apps_styling_nativewind_nativewind_tailwind_v4_to_v3_class_mapping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/design-mobile-apps/styling/nativewind.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_design_mobile_apps_styling_nativewind", "target": "agents_skills_design_mobile_apps_styling_nativewind_nativewind_theme_token_porting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/design-mobile-apps/styling/nativewind.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_design_mobile_apps_styling_nativewind", "target": "agents_skills_design_mobile_apps_styling_nativewind_nativewind_build_step_checklist", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/design-mobile-apps/styling/nativewind.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_design_mobile_apps_styling_nativewind", "target": "agents_skills_design_mobile_apps_styling_nativewind_nativewind_units_root_font_size", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/design-mobile-apps/styling/nativewind.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_design_mobile_apps_styling_nativewind", "target": "agents_skills_design_mobile_apps_styling_nativewind_nativewind_third_party_class_mapping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/design-mobile-apps/styling/nativewind.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_design_mobile_apps_styling_nativewind_nativewind_major_compatibility_matrix", "target": "agents_skills_design_mobile_apps_styling_nativewind_nativewind_tailwind_v4_to_v3_class_mapping", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/design-mobile-apps/styling/nativewind.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_design_mobile_apps_styling_nativewind_nativewind_build_step_checklist", "target": "agents_skills_design_mobile_apps_styling_nativewind_nativewind_theme_token_porting", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".agents/skills/design-mobile-apps/styling/nativewind.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_design_mobile_apps_styling_nativewind_nativewind_units_root_font_size", "target": "agents_skills_design_mobile_apps_styling_stylesheet_stylesheet_dip_unit_mapping", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".agents/skills/design-mobile-apps/styling/nativewind.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_design_mobile_apps_styling_nativewind_nativewind_theme_token_porting", "target": "agents_skills_design_mobile_apps_styling_uniwind_uniwind_global_css_theme", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.8, "source_file": ".agents/skills/design-mobile-apps/styling/nativewind.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_design_mobile_apps_styling_nativewind_nativewind_third_party_class_mapping", "target": "agents_skills_design_mobile_apps_styl