{"nodes": [{"id": "agents_skills_react_best_practices_rules_rendering_hydration_no_flicker", "label": "Prevent Hydration Mismatch Without Flickering", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/rendering-hydration-no-flicker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Content that depends on client-side storage (localStorage, cookies) either breaks SSR or flashes after hydration; a synchronous inline script updates the DOM before React hydrates, avoiding both failure modes."}, {"id": "agents_skills_react_best_practices_rules_rendering_hydration_no_flicker_themewrapper", "label": "ThemeWrapper", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/rendering-hydration-no-flicker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_rendering_hydration_no_flicker_inline_sync_script", "label": "Synchronous Inline Theme Script", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/rendering-hydration-no-flicker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The inline script executes synchronously before the element is shown, so the DOM already carries the correct value and no flicker or hydration mismatch occurs; the pattern suits theme toggles, user preferences and authentication state."}, {"id": "agents_skills_react_best_practices_rules_rendering_hydration_no_flicker_react_hydration_mismatch", "label": "React Hydration Mismatch", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/rendering-hydration-no-flicker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agents_skills_react_best_practices_rules_render