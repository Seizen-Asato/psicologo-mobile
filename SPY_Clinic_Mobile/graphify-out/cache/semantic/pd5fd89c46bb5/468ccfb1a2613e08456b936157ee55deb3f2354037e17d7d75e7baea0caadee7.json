{"nodes": [{"id": "agents_skills_react_best_practices_rules_js_cache_storage", "label": "Cache Storage API Calls", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/js-cache-storage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "localStorage, sessionStorage and document.cookie are synchronous and expensive, so reading them on every call multiplies costly I/O. Cache reads in memory instead."}, {"id": "agents_skills_react_best_practices_rules_js_cache_storage_storagecache", "label": "Map-Based Storage Cache", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/js-cache-storage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A module-level Map is used instead of a hook so the cache works everywhere: utilities and event handlers, not just React components."}, {"id": "agents_skills_react_best_practices_rules_js_cache_storage_getlocalstorage", "label": "getLocalStorage", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/js-cache-storage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_js_cache_storage_setlocalstorage", "label": "setLocalStorage", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/js-cache-storage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_js_cache_storage_cookiecache", "label": "Cookie Cache", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/js-cache-storage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_js_cache_storage_cache_invalidation", "label": "Cache Invalidation on External Storage Change", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/js-cache-storage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If storage can change externally (another tab, server-set cookies) the in-memory cache becomes stale, so it must be invalidated on the 'storage' event and on visibilitychange."}, {"id": "agents_skills_react_best_practices_rules_js_cache_storage_browser_storage_apis", "label": "Browser Storage APIs (localStorage, sessionStorage, document.cookie)", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/js-cache-storage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agents_skills_react_best_practices_rules_js_cache_storage", "target": "agents_skills_react_best_practices_rules_js_cache_storage_storagecache", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/js-cache-storage.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_js_cache_storage", "target": "agents_skills_react_best_practices_rules_js_cache_storage_browser_storage_apis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/js-cache-storage.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_js_cache_storage_storagecache", "target": "agents_skills_react_best_practices_rules_js_cache_storage_getlocalstorage", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/js-cache-storage.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_p