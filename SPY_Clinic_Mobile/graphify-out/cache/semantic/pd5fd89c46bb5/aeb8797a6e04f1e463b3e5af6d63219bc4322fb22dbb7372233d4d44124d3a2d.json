{"nodes": [{"id": "agents_skills_eas_app_stores_skill", "label": "EAS App Store Deployment Skill", "file_type": "document", "source_file": ".agents/skills/eas-app-stores/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_eas_app_stores_skill_eas_app_stores_project_path_selection", "label": "Project Path Selection for Store Releases", "file_type": "rationale", "source_file": ".agents/skills/eas-app-stores/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The native iOS path keeps the Xcode project and Swift code as the app's source of truth, so the Expo/React Native quick-start and development-client examples are explicitly excluded from it; EAS is a delivery service and native apps can use it without adding Expo or React Native to their runtime."}, {"id": "agents_skills_eas_app_stores_skill_eas_app_stores_eas_json_configuration", "label": "eas.json Configuration for Builds and Submits", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "eas init links or creates the EAS project and eas build:configure creates build profiles; existing project and store identifiers are preserved when a release setup already exists, and appVersionSource remote makes EAS the source of truth for version numbers."}, {"id": "agents_skills_eas_app_stores_skill_eas_app_stores_build_submit_commands", "label": "EAS Build and Submit Command Surface", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Production builds, per-platform builds and --auto-submit cover the normal release path, while npx testflight is the Expo/React Native shortcut for iOS TestFlight."}, {"id": "agents_skills_eas_app_stores_skill_eas_app_stores_remote_version_management", "label": "Remote Version Management", "file_type": "rationale", "source_file": ".agents/skills/eas-app-stores/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EAS manages version numbers automatically via appVersionSource remote, but the remote counter alone does not prove Xcode used it, so the archived CFBundleVersion must be inspected when native iOS versioning is set up or changed."}, {"id": "agents_skills_eas_app_stores_skill_eas_app_stores_release_state_verification", "label": "Release State Verification Discipline", "file_type": "rationale", "source_file": ".agents/skills/eas-app-stores/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A successful EAS build or a queued submission does not establish Apple acceptance, tester access, or an App Store release; the exact build ID/version and the furthest verified release state must be reported instead."}], "edges": [{"source": "agents_skills_eas_app_stores_skill", "target": "agents_skills_eas_app_stores_skill_eas_app_stores_project_path_selection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-app-stores/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_app_stores_skill", "target": "agents_skills_eas_app_stores_skill_eas_app_stores_eas_json_configuration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-app-stores/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_app_stores_skill", "target": "agents_skills_eas_app_stores_skill_eas_app_stores_build_submit_commands", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/