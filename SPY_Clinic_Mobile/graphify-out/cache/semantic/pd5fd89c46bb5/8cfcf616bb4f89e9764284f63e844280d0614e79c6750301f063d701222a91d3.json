{"nodes": [{"id": "agents_skills_eas_app_stores_references_ios_app_store", "label": "Submitting to iOS App Store", "file_type": "document", "source_file": ".agents/skills/eas-app-stores/references/ios-app-store.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_eas_app_stores_references_ios_app_store_ios_credential_setup", "label": "iOS Credential Setup", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/ios-app-store.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An App Store Connect API key is recommended because it avoids 2FA prompts in CI/CD; Apple ID with an app-specific password is the manual alternative, and private key material is kept outside version control."}, {"id": "agents_skills_eas_app_stores_references_ios_app_store_ios_app_store_connect_setup", "label": "App Store Connect First-Time Setup", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/ios-app-store.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The app record must exist in App Store Connect before submission, with bundle ID matching the archive, plus pricing/availability, app privacy declarations and reviewer contact information; Xcode is authoritative for the bundle ID of checked-in native projects."}, {"id": "agents_skills_eas_app_stores_references_ios_app_store_ios_testflight_vs_app_store", "label": "TestFlight versus App Store Distribution", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/ios-app-store.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TestFlight covers beta testing (up to 100 internal and 10,000 external testers, builds expiring after 90 days, external beta review required) while a public App Store release additionally requires passing App Review."}, {"id": "agents_skills_eas_app_stores_references_ios_app_store_ios_public_release_procedure", "label": "Complete the Public Release Procedure", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/ios-app-store.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EAS Submit only uploads the binary; public distribution continues in App Store Connect by selecting the exact processed build, completing listing and review information, adding for review then submitting for review, and applying the chosen release timing. Uploading a TestFlight beta does not itself request a public launch."}, {"id": "agents_skills_eas_app_stores_references_ios_app_store_ios_app_review_process", "label": "App Review Process and Rejection Reasons", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/ios-app-store.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reviewers check functionality, UI/UX against the Human Interface Guidelines, content, privacy and legal compliance; common rejections include crashes, incomplete metadata, placeholder content, missing login credentials, a missing privacy policy and Guideline 4.2 minimum functionality."}, {"id": "agents_skills_eas_app_stores_references_ios_app_store_ios_version_and_build_numbers", "label": "iOS Version and Build Numbers", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/ios-app-store.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CFBundleShortVersionString is the user-facing version while CFBundleVersion is internal and must increment for every upload; with autoIncrement and remote versioning EAS increments its counter and writes native version metadata during the build, but the archive's CFBundleVersion must still be verified."}, {"id": "agents_skills_eas_app_stores_references_ios_app_store_ios_release_options", "label": "iOS Release Options", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/ios-app-store.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automatic, scheduled and phased release are fragments of store.config.json for EAS Metadata, but uploading with EAS Submit still requires selecting the processed build and completing App Review before a public release."}, {"id": "agents_skills_eas_app_stores_references_ios_app_store_ios_certificates_and_provisioning", "label": "Distribution Certificates and Provisioning Profiles", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/ios-app-store.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A distribution certificate is limited to three per Apple Developer account and valid for one year, while App Store provisioning profiles link app, certificate and entitlements without device UDIDs; EAS manages both automatically."}], "edges": [{"source": "agents_skills_eas_app_stores_references_ios_app_store", "target": "agents_skills_eas_app_stores_references_ios_app_store_ios_credential_setup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-app-stores/references/ios-app-store.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_app_stores_references_ios_app_store", "target": "agents_skills_eas_app_stores_references_ios_app_store_ios_app_store_connect_setup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-app-stores/references/ios-app-store.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_app_stores_references