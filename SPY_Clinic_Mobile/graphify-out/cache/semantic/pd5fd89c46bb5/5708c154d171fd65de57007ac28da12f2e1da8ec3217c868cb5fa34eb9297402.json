{"nodes": [{"id": "agents_skills_eas_app_stores_references_native_ios", "label": "Native Swift iOS Apps on EAS", "file_type": "document", "source_file": ".agents/skills/eas-app-stores/references/native-ios.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_eas_app_stores_references_native_ios_native_ios_small_delivery_wrapper", "label": "Keep the Delivery Wrapper Small", "file_type": "rationale", "source_file": ".agents/skills/eas-app-stores/references/native-ios.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hand-maintained native code stays checked in and expo prebuild --clean is not a setup step for this path, because it would regenerate the native directories and destroy the project's source of truth."}, {"id": "agents_skills_eas_app_stores_references_native_ios_native_ios_minimal_package_json", "label": "Minimal package.json for Native Projects", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/native-ios.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The package file is tooling metadata, not a JavaScript app: expo, react, react-native, index.js, Metro and expo-dev-client must not be added merely to use EAS, and a matching lockfile for the chosen package manager is kept."}, {"id": "agents_skills_eas_app_stores_references_native_ios_native_ios_podfile_adapter", "label": "Minimal Podfile Adapter", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/native-ios.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The default EAS iOS worker still runs pod install for checked-in native projects, so a minimal Podfile with the app's real deployment target and target name serves as an adapter without adding React Native pods; projects that must avoid CocoaPods use a custom EAS build instead."}, {"id": "agents_skills_eas_app_stores_references_native_ios_native_ios_build_and_submit_profiles", "label": "Native iOS Build and Submit Profiles", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/native-ios.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The actual shared scheme is selected and explicit build configurations are used, because developmentClient: true configures the Expo development client rather than generic Swift debugging; ascAppId is the numeric App Store Connect app ID, not the EAS project UUID, bundle ID or Apple team ID."}, {"id": "agents_skills_eas_app_stores_references_native_ios_native_ios_explicit_infoplist_versioning", "label": "Explicit Info.plist Version Ownership", "file_type": "rationale", "source_file": ".agents/skills/eas-app-stores/references/native-ios.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A generated plist with a fixed CURRENT_PROJECT_VERSION can leave every archive reporting build 1 while the EAS dashboard shows increasing numbers, so an explicit INFOPLIST_FILE with GENERATE_INFOPLIST_FILE = NO is the tested approach; changing only app.json or observing an incremented remote counter is insufficient evidence."}, {"id": "agents_skills_eas_app_stores_references_native_ios_native_ios_icon_alpha_channel_check", "label": "AppIcon Alpha Channel Check", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/native-ios.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The default (Any/light) 1024px AppIcon PNG must have no alpha channel even if every pixel looks opaque, because an all-opaque RGBA file can still be rejected; transparency is preserved in dark variants and Icon Composer layers."}, {"id": "agents_skills_eas_app_stores_references_native_ios_native_ios_ship_the_exact_build", "label": "Ship the Exact Build", "file_type": "rationale", "source_file": ".agents/skills/eas-app-stores/references/native-ios.md", "source_location": null, "source_url": null, "author": null, "contributor": null, "rationale": "The explicit build ID is used when multiple builds exist and an eligible uploaded build is reused for production only when its release code, icon, configuration and version already match; a successful upload does not create tester access or release the app publicly, and TestFlight distribution alone does not authorize a public release."}, {"id": "agents_skills_eas_app_stores_references_native_ios_native_ios_verification_scope", "label": "Native iOS Path Verification Scope", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/native-ios.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The approach was exercised with a SwiftUI app on EAS CLI 18.6.0 and Xcode 26.2, so worker/CLI behavior must be rechecked when tooling changes because project layout, custom hooks, extensions and signing requirements can differ."}], "edges": [{"source": "agents_skills_eas_app_stores_references_native_ios", "target": "agents_skills_eas_app_stores_references_native_ios_native_ios_small_delivery_wrapper", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-app-stores/references/native-ios.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_app_stores_references_native_ios", "target": "agents_skills_eas_app_stores_references_native_ios_native_ios_minimal_package_json", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-app-stores/references/native-ios.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_app_stores_references_native_ios", "target": "agents_skills_eas_app_stores_references_native_ios_native_ios_podfile_adapter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-app-stores/references/native-ios.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_app_stores_references_native_ios", "target": "agents_skills_eas_app_stores_references_native_ios_native_ios_build_and_submit_profiles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-app-stores/references/native-ios.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_app_stores_references_native_ios", "target": "agents_skills_eas_app_stores_references_native_ios_native_ios_explicit_infoplist_versioning", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-app-stores/references/native-ios.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_app_stores_references_native_ios", "target": "agents_skills_eas_app_stores_references_native_ios_native_ios_icon_alpha_channel_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-app-stores/references/native-ios.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_app_stores_references_native_ios", "target": "agents_skills_eas_app_stores_references_native_ios_native_ios_ship_the_exact_build", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-app-stores/references/native-ios.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_app_stores_references_native_ios", "target": "agents_skills_eas_app_stores_references_native_ios_native_ios_verification_scope", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "sou