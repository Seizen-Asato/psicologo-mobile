{"nodes": [{"id": "agents_skills_accessibility_references_a11y_patterns", "label": "Accessibility Code Patterns", "file_type": "document", "source_file": ".agents/skills/accessibility/references/A11Y-PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_accessibility_references_a11y_patterns_modal_focus_trap", "label": "Modal Focus Trap Pattern", "file_type": "rationale", "source_file": ".agents/skills/accessibility/references/A11Y-PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tab and Shift+Tab must cycle inside the dialog and Escape must close it, otherwise keyboard users are trapped. The native <dialog> element already handles the trap, so it is preferred where browser support allows."}, {"id": "agents_skills_accessibility_references_a11y_patterns_skip_link", "label": "Skip Link Pattern", "file_type": "rationale", "source_file": ".agents/skills/accessibility/references/A11Y-PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets keyboard users bypass repetitive navigation and jump straight to main content; the link is visually hidden off-canvas until focused."}, {"id": "agents_skills_accessibility_references_a11y_patterns_error_handling", "label": "Error Handling Pattern", "file_type": "rationale", "source_file": ".agents/skills/accessibility/references/A11Y-PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Errors must be announced to screen readers with role=\"alert\" and the first invalid field must receive focus on submit, so the user is not left hunting for which field failed."}, {"id": "agents_skills_accessibility_references_a11y_patterns_form_labels", "label": "Form Labels Pattern", "file_type": "rationale", "source_file": ".agents/skills/accessibility/references/A11Y-PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every input needs a programmatically associated label, either explicit (for/id) or implicit (wrapping label), plus optional instructions wired through aria-describedby."}, {"id": "agents_skills_accessibility_references_a11y_patterns_dragging_movements", "label": "Dragging Movements Pattern", "file_type": "rationale", "source_file": ".agents/skills/accessibility/references/A11Y-PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any action triggered by dragging must offer a single-pointer alternative; the same rule extends to sliders, map panning and colour pickers."}, {"id": "agents_skills_accessibility_references_a11y_patterns_aria_tabs", "label": "ARIA Tabs Pattern", "file_type": "rationale", "source_file": ".agents/skills/accessibility/references/A11Y-PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tabs require role=tablist/tab/tabpanel with aria-selected, aria-controls and roving tabindex, because arrow-key navigation and a single tab stop are what screen-reader users expect from a tab widget."}, {"id": "agents_skills_accessibility_references_a11y_patterns_live_regions", "label": "Live Regions and Notifications Pattern", "file_type": "rationale", "source_file": ".agents/skills/accessibility/references/A11Y-PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "aria-live announces dynamic content without moving focus; polite waits for a pause in speech while assertive interrupts. The container must be cleared before writing so a repeated message still triggers a new announcement."}, {"id": "agents_skills_accessibility_references_a11y_patterns_screen_reader_commands", "label": "Screen Reader Commands Reference (VoiceOver / NVDA)", "file_type": "concept", "source_file": ".agents/skills/accessibility/references/A11Y-PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_accessibility_references_a11y_patterns_openmodal", "label": "openModal()", "file_type": "code", "source_file": ".agents/skills/accessibility/references/A11Y-PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_accessibility_references_a11y_patterns_shownotification", "label": "showNotification()", "file_type": "code", "source_file": ".agents/skills/accessibility/references/A11Y-PATTERNS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agents_skills_accessibility_references_a11y_patterns", "target": "agents_skills_accessibility_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/accessibility/references/A11Y-PATTERNS.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_accessibility_references_a11y_patterns", "target": "agents_skills_accessibility_references_a11y_patterns_modal_focus_trap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/accessibility/references/A11Y-PATTERNS.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_accessibility_references_a11y_patterns", "target": "agents_skills_accessibility_references_a11y_patterns_skip_link", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/accessibility/references/A11Y-PATTERNS.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_accessibility_references_a11y_patterns", "target": "agents_skills_accessibility_references_a11y_patterns_error_handling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/accessibility/references/A11Y-PATTERNS.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_accessibility_references_a11y_patterns", "target": "agents_skills_accessibility_references_a11y_patterns_form_labels", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/accessibility/references/A11Y-PATTERNS.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_accessibility_references_a11y_patterns", "target": "agents_skills_accessibility_references_a11y_patterns_dragging_movements", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/accessibility/references/A11Y-PATTERNS.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_accessibility_references_a11y_patterns", "target": "agents_skills_accessibility_references_a11y_patterns_aria_tabs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/accessibility/references/A11Y-PATTERNS.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_accessibility_references_a11y_patterns", "target": "agents_skills_accessibility_references_a11y_patterns_live_regions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/accessibility/references/A11Y-PATTERNS.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_accessibility_references_a11y_patterns", "target": "agents_skills_accessibility_references_a11y_patterns_screen_reader_commands", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/accessibility/references/A11Y-PATTERNS.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_accessibility_references_a11y_patterns_openmodal", "target": "agents_skills_accessibility_references_a11y_patterns_modal_focus_trap", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/accessibility/references/A11Y-PATTERNS.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_accessibility_references_a11y_patterns_shownotification", "target": "agents_skills_accessibility_references_a11y_patterns_live_regions", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/accessibility/references/A11Y-PATTERNS.md", "source_location": null, "weight": 1.0}], "hyperedges": []}