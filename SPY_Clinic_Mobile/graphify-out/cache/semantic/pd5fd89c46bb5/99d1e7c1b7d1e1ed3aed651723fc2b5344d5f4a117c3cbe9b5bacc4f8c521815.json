{"nodes": [{"id": "agents_skills_react_best_practices_rules_js_cache_property_access_cache_property_access_in_loops", "label": "Cache Property Access in Loops", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/js-cache-property-access.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hoisting an invariant property lookup out of the loop body turns three lookups per iteration into one, which matters when the loop runs on every render."}, {"id": "agents_skills_react_best_practices_rules_js_cache_property_access_loop_invariant_hoisting", "label": "Loop-Invariant Lookup Hoisting", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/js-cache-property-access.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reading the same unchanged property on every iteration repeats the lookup; computing it once before the loop removes the repeated work, and caching the array length likewise avoids a per-iteration bounds read."}], "edges": [{"source": "agents_skills_react_best_practices_rules_js_cache_property_access_cache_property_access_in_loops", "target": "agents_skills_react_best_practices_rules__template_rule_document_template", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".agents/skills/react-best-practices/rules/js-cache-property-access.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_js_cache_property_access_cache_property_access_in_loops", "target": "agents_skills_react_best_practices_rules_js_cache_property_access_loop_invariant_hoisting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/js-cache-property-access.md", "source_location": "L10, L23-L27", "weight": 1.0}], "hyperedges": []}