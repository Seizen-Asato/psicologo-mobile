{"nodes": [{"id": "agents_skills_react_best_practices_rules_rerender_functional_setstate_functional_setstate_updates", "label": "Use Functional setState Updates", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/rerender-functional-setstate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The functional update form of setState always operates on the latest state value, so callbacks need no state dependency. This eliminates stale closures, keeps callback references stable (children do not re-render), simplifies dependency arrays and prevents the most common React closure bugs."}, {"id": "agents_skills_react_best_practices_rules_rerender_functional_setstate_todolist", "label": "TodoList", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/rerender-functional-setstate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_rerender_functional_setstate_itemseditor", "label": "ItemsEditor", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/rerender-functional-setstate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_rerender_functional_setstate_stale_closure_bug", "label": "Stale Closure Bug", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/rerender-functional-setstate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A callback that closes over state but omits it from its dependency array always reads the initial value; the same callback written with a direct state reference must be recreated on every state change, causing unnecessary child re-renders."}], "edges": [{"source": "agents_skills_react_best_practices_rules_rerender_functional_setstate_functional_setstate_updates", "target": "agents_skills_react_best_practices_rules_rerender_functional_setstate_todolist", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/rerender-functional-setstate.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_rerender_functional_setstate_todolist", "target": "agents_skills_react_best_practices_rules_rerender_functional_setstate_itemseditor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/rerender-functional-setstate.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_rerender_functional_setstate_functional_setstate_updates", "target": "agents_skills_react_best_practices_rules_rerender_functional_setstate_stale_closure_bug", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/rerender-functional-setstate.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_rerender_functional_setstate_functional_setstate_updates", "target": "agents_skills_react_best_practices_rules_rerender_memo_react_compiler", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".agents/skills/react-best-practices/rules/rerender-functional-setstate.md", "source_location": null, "weight": 1.0}], "hyperedges": []}