{"nodes": [{"id": "agents_skills_eas_app_stores_references_play_store", "label": "Submitting to Google Play Store", "file_type": "document", "source_file": ".agents/skills/eas-app-stores/references/play-store.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_eas_app_stores_references_play_store_play_store_service_account_setup", "label": "Google Play Service Account Setup", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/play-store.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A service account key path in eas.json (or a base64 environment variable or EAS secret) authenticates automated submissions; the key must be kept out of version control and granted release permissions in Play Console."}, {"id": "agents_skills_eas_app_stores_references_play_store_play_store_release_tracks", "label": "Google Play Release Tracks", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/play-store.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "internal (up to 100 testers), alpha (closed testing), beta (open testing) and production (public release) form the staged rollout ladder; the default eas submit creates the first release on the internal track."}, {"id": "agents_skills_eas_app_stores_references_play_store_play_store_staged_rollout", "label": "Staged Rollout and Release Status", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/play-store.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "releaseStatus selects completed, draft, halted or inProgress, and inProgress with a rollout percentage releases to a slice of users, to be increased via Play Console or subsequent submissions."}, {"id": "agents_skills_eas_app_stores_references_play_store_play_store_app_signing", "label": "Google Play App Signing", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/play-store.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EAS uses Google Play App Signing by default: the first upload creates an upload key, Play Store manages and re-signs with the signing key, and the upload key can be reset if compromised."}, {"id": "agents_skills_eas_app_stores_references_play_store_play_store_version_codes", "label": "Android versionCode Management", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/play-store.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Android requires an incremented versionCode for each upload; autoIncrement with appVersionSource remote lets EAS track version codes automatically, and new apps must ship an AAB rather than an APK."}, {"id": "agents_skills_eas_app_stores_references_play_store_play_store_submission_monitoring", "label": "Google Play Submission Monitoring", "file_type": "rationale", "source_file": ".agents/skills/eas-app-stores/references/play-store.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "eas submit:list and eas submit:view report EAS submission jobs on CLI 23.2.0, but submit:status reads Apple status only, so an EAS job's success must not be treated as confirmation of a Play Console rollout."}], "edges": [{"source": "agents_skills_eas_app_stores_references_play_store", "target": "agents_skills_eas_app_stores_references_play_store_play_store_service_account_setup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-app-stores/references/play-store.md", "source_location": null, "weight": 1.0}, {"source": 