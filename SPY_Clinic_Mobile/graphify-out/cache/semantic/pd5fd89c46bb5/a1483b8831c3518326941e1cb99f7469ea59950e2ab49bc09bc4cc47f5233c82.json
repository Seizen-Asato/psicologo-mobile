{"nodes": [{"id": "agents_skills_react_best_practices_rules_advanced_effect_event_deps_effect_event_in_dependency_arrays", "label": "Do Not Put Effect Events in Dependency Arrays", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/advanced-effect-event-deps.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Effect Event functions intentionally get a new identity on every render, so listing one in a useEffect dependency array makes the effect re-run every render and trips the React Hooks lint rule; depend on the reactive values and call the Effect Event from inside the effect body or its subscriptions."}, {"id": "agents_skills_react_best_practices_rules_advanced_effect_event_deps_chatroom", "label": "ChatRoom (Effect Event dependency example)", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/advanced-effect-event-deps.md", "source_location": "L17-L53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "agents_skills_react_best_practices_rules_advanced_effect_event_deps_effect_event_in_dependency_arrays", "target": "agents_skills_react_best_practices_rules__template_rule_document_template", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".agents/skills/react-best-practices/rules/advanced-effect-event-deps.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_advanced_effect_event_deps_effect_event_in_dependency_arrays", "target": "agents_skills_react_best_practices_rules_advanced_effect_event_deps_chatroom", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/advanced-effect-event-deps.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_advanced_ef