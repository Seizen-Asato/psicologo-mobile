{"nodes": [{"id": "agents_skills_eas_hosting_skill", "label": "EAS Hosting Skill", "file_type": "document", "source_file": ".agents/skills/eas-hosting/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_eas_hosting_skill_eas_hosting_api_routes", "label": "Expo Router API Routes (+api.ts)", "file_type": "concept", "source_file": ".agents/skills/eas-hosting/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "API routes live in the app directory with a +api.ts suffix and export named functions per HTTP method (GET, POST, PUT, DELETE, OPTIONS), with dynamic segments exposing path params and catch-all routes exposing a slug array."}, {"id": "agents_skills_eas_hosting_skill_eas_hosting_api_route_use_criteria", "label": "When to Use (and Avoid) API Routes", "file_type": "rationale", "source_file": ".agents/skills/eas-hosting/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "API routes exist for server-side secrets, database operations, third-party API proxies, server-side validation, webhook endpoints, rate limiting and heavy computation; they are avoided when data is already public, no secrets are required, real-time updates are needed, the case is simple CRUD, uploads are involved, or authentication is the only concern."}, {"id": "agents_skills_eas_hosting_skill_eas_hosting_cloudflare_workers_runtime", "label": "Cloudflare Workers Runtime Limits", "file_type": "rationale", "source_file": ".agents/skills/eas-hosting/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "API routes run on Cloudflare Workers, so there is no Node.js filesystem, no native Node modules, a 30 second CPU timeout and no persistent connections (WebSockets need Durable Objects); Web APIs such as crypto.subtle, fetch, Request and Response replace Node equivalents."}, {"id": "agents_skills_eas_hosting_skill_eas_hosting_deployment_workflow", "label": "EAS Hosting Deployment Workflow", "file_type": "concept", "source_file": ".agents/skills/eas-hosting/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "npx expo export -p web ships the web bundle and any Expo Router API routes together, so a single eas deploy handles a full website, an API-routes-only backend, or both; --prod promotes a preview URL to production."}, {"id": "agents_skills_eas_hosting_skill_eas_hosting_environment_secrets", "label": "Hosting Environment Secrets", "file_type": "concept", "source_file": ".agents/skills/eas-hosting/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server-side secrets are read from process.env and provisioned with eas env:create per environment or through the Expo dashboard, keeping API keys out of the client bundle."}, {"id": "agents_skills_eas_hosting_skill_eas_hosting_database_options", "label": "Edge Database Options", "file_type": "concept", "source_file": ".agents/skills/eas-hosting/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Because the filesystem is unavailable, storage must be a cloud database: Cloudflare D1, Turso, PlanetScale, Supabase or Neon, each reached over its HTTP/REST client."}, {"id": "agents_skills_eas_hosting_skill_eas_hosting_auth_middleware", "label": "API Route Authentication Middleware", "file_type": "concept", "source_file": ".agents/skills/eas-hosting/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A shared requireAuth helper extracts the bearer token from the Authorization header and throws a 401 Response, so protected routes share one token-verification path rather than repeating it."}, {"id": "agents_skills_eas_hosting_skill_eas_hosting_rules", "label": "API Route Rules", "file_type": "rationale", "source_file": ".agents/skills/eas-hosting/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never expose API keys or secrets in client code, always validate and sanitize user input, use proper HTTP status codes, handle errors gracefully with try/catch, keep one responsibility per endpoint, use TypeScript, and log errors server-side for debugging."}], "edges": [{"source": "agents_skills_eas_hosting_skill", "target": "agents_skills_eas_hosting_skill_eas_hosting_api_routes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-hosting/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_hosting_skill", "target": "agents_skills_eas_hosting_skill_eas_hosting_api_route_use_criteria", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-hosting/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_hosting_skill", "target": "agents_skills_eas_hosting_skill_eas_hosting_cloudflare_workers_runtime", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-hosting/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_hosting_skill", "target": "agents_skills_eas_hosting_skill_eas_hosting_deployment_workflow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-hosting/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_hosting_skill", "target": "agents_skills_eas_hosting_skill_eas_hosting_environment_secrets", "relation": "references", "confidence": "EXTRACTED", "confidence_score