{"nodes": [{"id": "agents_context_design_system", "label": "PsicoTools Design Context", "file_type": "document", "source_file": ".agents/context/design-system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_context_design_system_color_palette", "label": "PsicoTools Color Palette", "file_type": "concept", "source_file": ".agents/context/design-system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_context_design_system_brand_tokens", "label": "Brand & Accent Primitive Color Tokens", "file_type": "concept", "source_file": ".agents/context/design-system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_context_design_system_semantic_tokens", "label": "Semantic Color Tokens (Light and Dark Modes)", "file_type": "concept", "source_file": ".agents/context/design-system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_context_design_system_contrast_rules", "label": "Verified WCAG AA Contrast Rules", "file_type": "rationale", "source_file": ".agents/context/design-system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contrast ratios were measured per token pair and the ratios are mandatory in mobile: normal text 4.5:1, large text 3:1. Lime and amber fail as small text on light backgrounds (2.62:1 / 2.09:1), so in light mode they are restricted to backgrounds, borders and large iconography; white text on lime is banned (2.76:1). Error red on dark and warning amber on light are demoted to borders/icons only, and the message body uses primary text on ink instead."}, {"id": "agents_context_design_system_touch_target", "label": "Minimum 44x44 Touch Target", "file_type": "concept", "source_file": ".agents/context/design-system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_context_design_system_typography", "label": "Typography and Font Stack (Roboto + fallbacks)", "file_type": "concept", "source_file": ".agents/context/design-system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_context_design_system_mobile_token_mapping", "label": "Native Design Token Mapping Instruction for Mobile AI", "file_type": "rationale", "source_file": ".agents/context/design-system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The palette and type tables are meant to be replicated verbatim as native design tokens (Color.kt, AppColors.dart, CSS variables) rather than re-invented, because FrontEnd/src/index.css is the single source of truth and new hex values are forbidden."}, {"id": "agents_context_design_system_frontend_index_css", "label": "FrontEnd/src/index.css (Source of Truth)", "file_type": "concept", "source_file": ".agents/context/design-system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agents_context_design_system", "target": "agents_context_design_system_color_palette", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/context/design-system.md", "source_location": null, "weight": 1.0}, {"source": "agents_context_design_system_color_palette", "target": "agents_context_design_system_brand_tokens", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/context/design-system.md", "source_location": null, "weight": 1.0}, {"source": "agents_context_design_system_color_palette", "target": "agents_context_design_system_semantic_tokens", "relation": "references", "confidence": "EXTRA