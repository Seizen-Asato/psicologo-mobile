{"nodes": [{"id": "agents_skills_react_best_practices_rules_client_passive_event_listeners_use_passive_event_listeners", "label": "Use Passive Event Listeners for Scrolling Performance", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/client-passive-event-listeners.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Browsers wait for touch and wheel listeners to finish before checking preventDefault(), which delays scrolling; passive listeners enable immediate scrolling but must not be used for listeners that need to prevent the default action."}, {"id": "agents_skills_react_best_practices_rules_client_passive_event_listeners_passive_listener_option", "label": "{ passive: true } listener option", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/client-passive-event-listeners.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Declares that a listener will not call preventDefault() so the browser can scroll without waiting; correct for tracking, analytics and logging, wrong for custom swipe gestures, zoom controls or any listener that must cancel the default behaviour."}], "edges": [{"source": "agents_skills_react_best_practices_rules_client_passive_event_listeners_use_passive_event_listeners", "target": "agents_skills_react_best_practices_rules__template_rule_document_template", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".agents/skills/react-best-practices/rules/client-passive-event-listeners.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_client_passive_event_listeners_use_passive_event_listeners", "target": "agents_skills_react_best_practices_rules_client_passive_event_listeners_passive_listener_option", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/client-passive-event-listeners.md", "source_location": "L10, L36-L37", "weight": 1.0}], "hyperedges": []}