{"nodes": [{"id": "agents_skills_expo_data_fetching_skill", "label": "Expo Networking (Data Fetching) Skill", "file_type": "document", "source_file": ".agents/skills/expo-data-fetching/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_expo_data_fetching_skill_four_screen_states", "label": "Four Screen States (Loading, Error, Empty, Content)", "file_type": "rationale", "source_file": ".agents/skills/expo-data-fetching/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loading is not empty: empty means resolved with zero items, not missing data, and in TanStack Query v5 a disabled or offline-paused query can have no data without being loading. Refetches keep stale content with a nonblocking error, and initial UI or redirects are gated on hydration to avoid flashing the wrong screen on cold start."}, {"id": "agents_skills_expo_data_fetching_skill_saves_preserve_work", "label": "Saves Preserve Work", "file_type": "rationale", "source_file": ".agents/skills/expo-data-fetching/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "While a mutation is pending repeat submission is disabled; on failure the draft is retained, an inline error is shown and the user can retry, and the draft is cleared only after success. Optimistic updates must restore the previous value or mark the edit unsynced on failure."}, {"id": "agents_skills_expo_data_fetching_skill_fetch_wrapper", "label": "Typed Fetch Wrapper", "file_type": "concept", "source_file": ".agents/skills/expo-data-fetching/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The response status must be checked before parsing, and axios is avoided in favour of expo/fetch so platform-specific networking behavior is preserved."}, {"id": "agents_skills_expo_data_fetching_skill_react_query_setup", "label": "React Query (TanStack Query) Setup", "file_type": "concept", "source_file": ".agents/skills/expo-data-fetching/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React Query is chosen for complex caching and state management while simpler needs use SWR or custom hooks; a QueryClientProvider with a staleTime and retry policy is mounted in the root layout, and mutations invalidate and refetch affected query keys."}, {"id": "agents_skills_expo_data_fetching_skill_api_error_typed_errors", "label": "ApiError Typed Error Handling", "file_type": "concept", "source_file": ".agents/skills/expo-data-fetching/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HTTP failures are surfaced as a typed ApiError carrying status and code, while transport failures are normalized to a NETWORK_ERROR with status 0, so callers can distinguish an API refusal from a connectivity failure."}, {"id": "agents_skills_expo_data_fetching_skill_retry_exponential_backoff", "label": "Retry with Exponential Backoff", "file_type": "concept", "source_file": ".agents/skills/expo-data-fetching/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_expo_data_fetching_skill_auth_token_management", "label": "Auth Token Management and Refresh", "file_type": "concept", "source_file": ".agents/skills/expo-data-fetching/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tokens live in expo-secure-store rather than AsyncStorage, and refresh uses a single in-flight promise guarded by an isRefreshing flag so concurrent callers share one refresh instead of stampeding the auth endpoint."}, {"id": "agents_skills_expo_data_fetching_skill_environment_variables", "label": "EXPO_PUBLIC_ Environment Variables", "file_type": "rationale", "source_file": ".agents/skills/expo-data-fetching/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only EXPO_PUBLIC_-prefixed variables reach the client bundle and they are inlined at build time, not runtime, so secrets must never use that prefix; server-side secrets in API routes use non-prefixed variables, and the dev server must be restarted after changing .env files."}, {"id": "agents_skills_expo_data_fetching_skill_request_cancellation", "label": "Request Cancellation", "file_type": "concept", "source_file": ".agents/skills/expo-data-fetching/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_expo_data_fetching_skill_offline_support", "label": "Offline Support", "file_type": "concept", "source_file": ".agents/skills/expo-data-fetching/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_expo_data_fetching_skill_securestore_vs_asyncstorage", "label": "SecureStore over AsyncStorage", "file_type": "rationale", "source_file": ".agents/skills/expo-data-fetching/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Storing tokens in AsyncStorage is explicitly marked wrong because it is not secure; SecureStore is the correct home for sensitive data."}, {"id": "agents_skills_expo_data_fetching_skill_networking_decision_tree", "label": "Networking Decision Tree", "file_type": "concept", "source_file": ".agents/skills/expo-data-fetching/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A routing decision tree maps each networking need (route-level loading, basic fetch, caching, authentication, error handling, offline, environment config, performance) to a specific technique so the approach is chosen deliberately rather than by default."}], "edges": [{"source": "agents_skills_expo_data_fetching_skill", "target": "agents_skills_expo_data_fetching_skill_four_screen_states", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/expo-data-fetching/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_expo_data_fetching_skill", "target": "agents_skills_expo_data_fetching_skill_saves_preserve_work", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/expo-data-fetching/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_expo_data_fetching_skill", "target": "agents_skills_expo_data_fetching_skill_fetch_wrapper", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/expo-data-fetching/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_expo_data_fetching_skill", "target": "agents_skills_expo_data_fetching_skill_react_query_setup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/expo-data-fetching/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_expo_data_fetching_skill", "target": "agents_skills_expo_data_fetching_skill_api_error_typed_errors", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/expo-data-fetching/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_expo_data_fetching_skill", "target": "agents_skills_expo_data_fetching_skill_retry_exponential_backoff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/expo-data-fetching/SKILL.md", "source_location": null, "weig