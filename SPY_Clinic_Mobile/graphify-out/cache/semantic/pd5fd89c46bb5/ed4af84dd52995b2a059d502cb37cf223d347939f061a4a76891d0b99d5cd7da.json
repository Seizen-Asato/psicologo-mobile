{"nodes": [{"id": "agents_skills_react_best_practices_rules_js_min_max_loop", "label": "Use Loop for Min/Max Instead of Sort", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/js-min-max-loop.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Finding the smallest or largest element only requires a single pass; sorting the whole array is O(n log n) and wasteful when only min/max are needed."}, {"id": "agents_skills_react_best_practices_rules_js_min_max_loop_getlatestproject", "label": "getLatestProject", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/js-min-max-loop.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_js_min_max_loop_getoldestandnewest", "label": "getOldestAndNewest", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/js-min-max-loop.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_js_min_max_loop_math_min_max_spread", "label": "Math.min/Math.max Spread Alternative", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/js-min-max-loop.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Math.min/Math.max with spread is fine for small arrays but can be slower or throw for very large arrays due to spread operator argument limits, so the explicit loop is more reliable."}, {"id": "agents_skills_react_best_practices_rules_js_min_max_loop_jsfiddle_array_spread_limit", "label": "JSFiddle Array Spread Limit Reference", "file_type": "document", "source_file": ".agents/skills/react-best-practices/rules/js-min-max-loop.md", "source_location": null, "source_url": "https://jsfiddle.net/