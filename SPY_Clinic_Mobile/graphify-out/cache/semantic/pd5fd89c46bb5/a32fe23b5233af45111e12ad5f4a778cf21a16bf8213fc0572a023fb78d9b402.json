{"nodes": [{"id": "agents_skills_typescript_advanced_types_references_details", "label": "TypeScript Advanced Types - Detailed Worked Examples", "file_type": "document", "source_file": ".agents/skills/typescript-advanced-types/references/details.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_typescript_advanced_types_references_details_typed_event_emitter", "label": "Type-Safe Event Emitter", "file_type": "concept", "source_file": ".agents/skills/typescript-advanced-types/references/details.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Typing listeners as a mapped type over the event map gives each event its own payload type, so emitting 'user:created' without the required 'name' field becomes a compile-time error rather than an undefined access at runtime."}, {"id": "agents_skills_typescript_advanced_types_references_details_type_safe_api_client", "label": "Type-Safe API Client", "file_type": "concept", "source_file": ".agents/skills/typescript-advanced-types/references/details.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Encoding endpoint, method, params, body and response in a single configuration type lets the compiler derive the request argument shape and the return type, so a malformed call fails at compile time instead of producing an unchecked network request."}, {"id": "agents_skills_typescript_advanced_types_references_details_builder_pattern", "label": "Builder Pattern with Type Safety", "file_type": "concept", "source_file": ".agents/skills/typescript-advanced-types/references/details.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accumulating state in the type parameter (S) makes build() callable only once all required keys are set, moving completeness checking from runtime validation to the type system."}, {"id": "agents_skills_typescript_advanced_types_references_details_deep_readonly_partial", "label": "Deep Readonly and Deep Partial", "file_type": "concept", "source_file": ".agents/skills/typescript-advanced-types/references/details.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A recursive mapped type propagates readonly/optional modifiers into nested objects and arrays, which the shallow built-in Readonly and Partial utilities cannot do."}, {"id": "agents_skills_typescript_advanced_types_references_details_type_safe_form_validation", "label": "Type-Safe Form Validation", "file_type": "concept", "source_file": ".agents/skills/typescript-advanced-types/references/details.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Encoding per-field validation rules in a mapped type yields a typed error map (string[] per field) returned as null when valid, so validation messages stay aligned with the form's own data shape."}, {"id": "agents_skills_typescript_advanced_types_references_details_discriminated_unions", "label": "Discriminated Unions", "file_type": "concept", "source_file": ".agents/skills/typescript-advanced-types/references/details.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A literal discriminator field (status or type) lets the compiler narrow union members, replacing runtime type checks with exhaustive switch narrowing of async state machines and request lifecycles."}, {"id": "agents_skills_typescript_advanced_types_references_details_type_inference_techniques", "label": "Type Inference Techniques", "file_type": "concept", "source_file": ".agents/skills/typescript-advanced-types/references/details.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_typescript_advanced_types_references_details_infer_keyword", "label": "Infer Keyword", "file_type": "concept", "source_file": ".agents/skills/typescript-advanced-types/references/details.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_typescript_advanced_types_references_details_type_guards", "label": "Type Guards", "file_type": "concept", "source_file": ".agents/skills/typescript-advanced-types/references/details.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A guard narrows an unknown value at runtime so downstream code can use the concrete type without assertions; composing a guard with a per-item guard (isArrayOf) narrows whole collections at once."}, {"id": "agents_skills_typescript_advanced_types_references_details_assertion_functions", "label": "Assertion Functions", "file_type": "concept", "source_file": ".agents/skills/typescript-advanced-types/references/details.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An assertion function (`asserts value is string`) narrows the value in the caller after it returns, but it throws at runtime, so it must only be used behind a genuine check rather than as a cast."}], "edges": [{"source": "agents_skills_typescript_advanced_types_references_details", "target": "agents_skills_typescript_advanced_types_references_details_typed_event_emitter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/typescript-advanced-types/references/details.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_typescript_advanced_types_references_details", "target": "agents_skills_typescript_advanced_types_references_details_type_safe_api_client", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/typescript-advanced-types/references/details.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_typescript_advanced_types_references_details", "target": "agents_skills_typescript_advanced_types_references_details_builder_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/typescript-advanced-types/references/details.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_typescript_advanced_types_references_details", "target": "agents_skills_typescript_advanced_types_references_details_deep_readonly_partial", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/typescript-advanced-types/references/details.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_typescript_advanced_types_references_details", "target": "agents_skills_typescript_advanced_types_references_details_type_safe_form_validation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/typescript-advanced-types/references/details.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_typescript_advanced_types_references_details", "target": "agents_skills_typescript_advanced_types_references_details_discriminated_unions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/typescript-advanced-types/references/details.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_typescript_advanced_types_references_details", "target": "agents_skills_typescript_advanced_types_references_details_type_inference_techniques", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/typescript-advanced-types/references/details.md", "source_location": null, "weight": 1.0}, {"source"