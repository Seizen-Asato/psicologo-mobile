{"nodes": [{"id": "agents_skills_react_best_practices_rules_rerender_no_inline_components_dont_define_components_inside_components", "label": "Don't Define Components Inside Components", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/rerender-no-inline-components.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A component defined inside another component creates a new component type on every render, so React unmounts and remounts it, destroying internal state, re-running effects and recreating DOM nodes. Pass props instead of closing over parent variables."}, {"id": "agents_skills_react_best_practices_rules_rerender_no_inline_components_userprofile", "label": "UserProfile", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/rerender-no-inline-components.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_rerender_no_inline_components_avatar", "label": "Avatar", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/rerender-no-inline-components.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_rerender_no_inline_components_stats", "label": "Stats", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/rerender-no-inline-components.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agents_skills_react_best_practices_rules_rerender_no_inline_components_dont_define_components_inside_components", "target": "agents_skills_react_best_practices_rules_rerender_no_inline_components_userprofile", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skill