{"nodes": [{"id": "agents_skills_eas_workflows_skill", "label": "EAS Workflows Skill", "file_type": "document", "source_file": ".agents/skills/eas-workflows/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_eas_workflows_skill_eas_workflows_schema_fetch", "label": "Live Workflow Schema Fetch", "file_type": "rationale", "source_file": ".agents/skills/eas-workflows/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The JSON schema and syntax documentation are fetched before generating or editing a workflow because these resources evolve as new features are added and memorized values go stale; the EAS CLI remains the authoritative final validator."}, {"id": "agents_skills_eas_workflows_skill_eas_workflows_file_location", "label": "Workflow File Location and Size Limit", "file_type": "concept", "source_file": ".agents/skills/eas-workflows/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_eas_workflows_skill_eas_workflows_top_level_structure", "label": "Workflow Top-Level Structure", "file_type": "concept", "source_file": ".agents/skills/eas-workflows/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A workflow file has name, on, jobs, defaults and concurrency top-level keys, with at least one trigger and a jobs map required."}, {"id": "agents_skills_eas_workflows_skill_eas_workflows_expressions", "label": "Workflow Expression Contexts", "file_type": "concept", "source_file": ".agents/skills/eas-workflows/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dynamic values use ${{ }} syntax over defined contexts \u2014 github, inputs, needs, jobs, steps and workflow \u2014 so expressions must reference valid contexts and outputs."}, {"id": "agents_skills_eas_workflows_skill_eas_workflows_validation", "label": "workflow:validate Command", "file_type": "rationale", "source_file": ".agents/skills/eas-workflows/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validation runs through eas-cli workflow:validate per changed file until it prints that the configuration is valid, because unlike schema-only validation it also checks build profile references against eas.json and performs EAS server-side validation; a local YAML or JSON Schema validator is not a substitute."}], "edges": [{"source": "agents_skills_eas_workflows_skill", "target": "agents_skills_eas_workflows_skill_eas_workflows_schema_fetch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-workflows/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_workflows_skill", "target": "agents_skills_eas_workflows_skill_eas_workflows_file_location", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-workflows/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_workflows_skill", "target": "agents_skills_eas_workflows_skill_eas_workflows_top_level_structure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-workflows/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_workflows_skill", "target": "agents_skills_eas_workflows_skill_eas_workflows_expressions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/eas-workflows/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_eas_workflows_skill", "target": "agents_skills_eas_workflows_skill_eas_workflows_validati