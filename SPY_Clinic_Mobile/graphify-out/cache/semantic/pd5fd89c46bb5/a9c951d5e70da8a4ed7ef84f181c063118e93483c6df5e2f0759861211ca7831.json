{"nodes": [{"id": "agents_skills_react_best_practices_rules_server_no_shared_module_state_avoid_shared_module_state_for_request_data", "label": "Avoid Shared Module State for Request Data", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/server-no-shared-module-state.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server renders run concurrently in the same process, so mutable module-level variables used for request-scoped data cause race conditions, cross-request contamination and leaks of one user's data into another user's response. Module scope on the server must be treated as process-wide shared memory, not request-local state."}, {"id": "agents_skills_react_best_practices_rules_server_no_shared_module_state_currentuser", "label": "currentUser", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/server-no-shared-module-state.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_server_no_shared_module_state_page", "label": "Page", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/server-no-shared-module-state.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_server_no_shared_module_state_dashboard", "label": "Dashboard", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/server-no-shared-module-state.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_server_no_shared_module_state_process_wide_shared_memory", "label": "Module Scope as Process-Wide Shared Memory", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/server-no-shared-module-state.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On the server, module scope is shared by all concurrent requests in the process, so it is only safe for immutable static assets, correctly keyed cross-request caches, and singletons that hold no request- or user-specific mutable data."}], "edges": [{"source": "agents_skills_react_best_practices_rules_server_no_shared_module_state_avoid_shared_module_state_for_request_data", "target": "agents_skills_react_best_practices_rules_server_no_shared_module_state_currentuser", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/server-no-shared-module-state.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_server_no_shared_module_state_avoid_shared_module_state_for_request_data", "target": "agents_skills_react_best_practices_rules_server_no_shared_module_state_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/server-no-shared-module-state.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_server_no_shared_module_state_avoid_shared_module_state_for_request_data", "target": "agents_skills_react_best_practices_rules_server_no_shared_module_state_dashboard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/server-no-shared-module-state.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_server_no_shared_module_state_avoid_shared_module_state_for_request_data", "target": "agents_skills_react_best_practices_rules_server_no_shared_module_state_process_wide_shared_memory", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.