{"nodes": [{"id": "agents_skills_react_best_practices_rules_async_suspense_boundaries_strategic_suspense_boundaries", "label": "Strategic Suspense Boundaries", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/async-suspense-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Awaiting data in an async component blocks the whole layout; moving the await behind a Suspense boundary paints the wrapper immediately and streams the data in, trading faster initial paint against possible layout shift. Not appropriate for SEO-critical content, layout-critical data, tiny fast queries, or when layout shift must be avoided."}, {"id": "agents_skills_react_best_practices_rules_async_suspense_boundaries_suspense", "label": "React Suspense boundary", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/async-suspense-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets a slow child suspend while the surrounding layout renders immediately, showing a fallback until the child's data resolves."}, {"id": "agents_skills_react_best_practices_rules_async_suspense_boundaries_datadisplay", "label": "DataDisplay (async child component)", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/async-suspense-boundaries.md", "source_location": "L51-L54, L79-L82", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "agents_skills_react_best_practices_rules_async_suspense_boundaries_datasummary", "label": "DataSummary (shared promise consumer)", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/async-suspense-boundaries.md", "source_location": "L84-L87", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "agents_skills_react_best_practices_rules_async_suspense_boundaries_use", "label": "use() (React promise unwrapping)", "file_type": "concept", "source_file": ".agents/skills/react-best-practices/rules/async-suspense-boundaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unwraps a promise during render so several components can share one in-flight request instead of each triggering its own fetch."}], "edges": [{"source": "agents_skills_react_best_practices_rules_async_suspense_boundaries_strategic_suspense_boundaries", "target": "agents_skills_react_best_practices_rules__template_rule_document_template", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".agents/skills/react-best-practices/rules/async-suspense-boundaries.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_async_suspense_boundaries_strategic_suspense_boundaries", "target": "agents_skills_react_best_practices_rules_async_suspense_boundaries_suspense", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/async-suspense-boundaries.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_async_suspense_boundaries_strategic_suspense_boundaries", "target": "agents_skills_react_best_practices_rules_async_suspense_boundaries_datadisplay", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/react-best-practices/rules/async-suspense-boundaries.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_react_best_practices_rules_async_suspense_boundaries_strategic_suspense_boundaries", "target": "agents_skills_react_best_practices_rules_async_suspense_boundaries_datasummary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": 