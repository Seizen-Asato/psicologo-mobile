{"nodes": [{"id": "agents_skills_design_mobile_apps_styling_uniwind", "label": "Styling: Uniwind", "file_type": "document", "source_file": ".agents/skills/design-mobile-apps/styling/uniwind.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_design_mobile_apps_styling_uniwind_uniwind_global_css_theme", "label": "Uniwind global.css Theme", "file_type": "concept", "source_file": ".agents/skills/design-mobile-apps/styling/uniwind.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uniwind consumes Tailwind v4 so the mockup's classes carry over unchanged, and it resolves theme colors from global.css; the project's existing file structure is followed and :root tokens are ported into --color-* names in whatever shape that file actually uses."}, {"id": "agents_skills_design_mobile_apps_styling_uniwind_uniwind_oklch_support", "label": "Uniwind OKLCH Token Support", "file_type": "rationale", "source_file": ".agents/skills/design-mobile-apps/styling/uniwind.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uniwind documents first-class OKLCH support, so oklch(...) values port across as-is instead of being converted to hex like other native styling paths require."}, {"id": "agents_skills_design_mobile_apps_styling_uniwind_uniwind_withuniwind_wrapping", "label": "withUniwind Third-Party Wrapping", "file_type": "concept", "source_file": ".agents/skills/design-mobile-apps/styling/uniwind.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Components from other libraries accept className once wrapped; wrapping each one once in its own file and importing the wrapped version everywhere keeps a single mapping instead of repeating withUniwind at every call site."}], "edges": [{"source": "agents_skil