{"nodes": [{"id": "agents_skills_eas_app_stores_references_testflight", "label": "TestFlight Reference", "file_type": "document", "source_file": ".agents/skills/eas-app-stores/references/testflight.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_eas_app_stores_references_testflight_testflight_submit_identified_build", "label": "Submit an Identified Build to TestFlight", "file_type": "concept", "source_file": ".agents/skills/eas-app-stores/references/testflight.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The source revision and returned build ID are recorded so the exact artifact can be submitted; for separate jobs the explicit build ID is passed rather than selecting whichever unrelated build is newest, and repeated noninteractive retries cannot complete first-time credential setup."}, {"id": "agents_skills_eas_app_stores_references_testflight_testflight_release_state_tracking", "label": "TestFlight Release State Tracking", "file_type": "rationale", "source_file": ".agents/skills/eas-app-stores/references/testflight.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each verified state establishes only a limited claim \u2014 build finished, submission queued, Apple upload/processing succeeded, build available to testers, App Review approved and released \u2014 and the furthest state actually verified must be reported rather than treating --no-wait success as a finished upload."}, {"id": "agents_skills_eas_app_stores_references_testflight_testflight_cli_version_gating", "label": "EAS CLI Version Gating for Submission Commands", "file_type": "rationale", "source_file": ".agents/skills/eas-app-stores/references/testflight.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": 