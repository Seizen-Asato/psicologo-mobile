{"nodes": [{"id": "agents_skills_react_best_practices_rules_server_hoist_static_io_hoist_static_io_to_module_level", "label": "Hoist Static I/O to Module Level", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/server-hoist-static-io.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Module-level code runs once when the module is first imported, so hoisting static asset reads (fonts for OG images, logos, config files, email templates) removes repeated filesystem or network I/O on every request. Assets that vary per request, change at runtime, are too large or are sensitive must not be hoisted."}, {"id": "agents_skills_react_best_practices_rules_server_hoist_static_io_get", "label": "GET route handler (OG image)", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/server-hoist-static-io.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_server_hoist_static_io_processrequest", "label": "processRequest", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/server-hoist-static-io.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_server_hoist_static_io_imageresponse", "label": "ImageResponse", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/server-hoist-static-io.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agents_skills_react_best_practices_rules_server_hoist_static_io_hoist_static_io_to_module_level", "target": "agents_skills_react_best_practices_rules_server_hoist_static_io_get", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skil