{"nodes": [{"id": "agents_skills_expo_data_fetching_references_expo_router_loaders", "label": "Expo Router Data Loaders Reference", "file_type": "document", "source_file": ".agents/skills/expo-data-fetching/references/expo-router-loaders.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_expo_data_fetching_references_expo_router_loaders_expo_router_data_loaders", "label": "Route-Level Data Loaders", "file_type": "concept", "source_file": ".agents/skills/expo-data-fetching/references/expo-router-loaders.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loaders are async functions exported from route files that load data before the route renders, following the Remix/React Router loader model. One function is written and the framework manages execution: server-side during initial SSR page load with JSON embedded in the HTML, and over HTTP on client-side navigation."}, {"id": "agents_skills_expo_data_fetching_references_expo_router_loaders_loader_function_type", "label": "LoaderFunction Type and Params", "file_type": "concept", "source_file": ".agents/skills/expo-data-fetching/references/expo-router-loaders.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loaders with params use LoaderFunction<T> from expo-server; the first argument is an immutable request-like object (undefined in static mode) and the second holds path parameters only, with query parameters read from new URL(request.url).searchParams."}, {"id": "agents_skills_expo_data_fetching_references_expo_router_loaders_server_vs_static_output", "label": "Server versus Static Web Output", "file_type": "rationale", "source_file": ".agents/skills/expo-data-fetching/references/expo-router-loaders.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server output runs the loader on every request with full request access and suits frequently changing or personalized content, while static output runs it at build time and suits content that is the same for all users; both require unstable_useServerDataLoaders and only server mode requires unstable_useServerRendering."}, {"id": "agents_skills_expo_data_fetching_references_expo_router_loaders_suspense_and_error_boundary", "label": "Suspense and ErrorBoundary Boundaries", "file_type": "concept", "source_file": ".agents/skills/expo-data-fetching/references/expo-router-loaders.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "useLoaderData suspends during client-side navigation, so the hook is pushed into a child component wrapped in Suspense; the boundary must sit above the component calling useLoaderData, and the nearest ErrorBoundary catches thrown StatusError values."}, {"id": "agents_skills_expo_data_fetching_references_expo_router_loaders_loader_server_side_secrets", "label": "Loader Server-Side Secrets", "file_type": "rationale", "source_file": ".agents/skills/expo-data-fetching/references/expo-router-loaders.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loaders run on the server and can read secrets and session cookies directly, so non-prefixed process.env variables are used there rather than EXPO_PUBLIC_ ones which are embedded in the client bundle."}, {"id": "agents_skills_expo_data_fetching_references_expo_router_loaders_response_utilities", "label": "StatusError and setResponseHeaders", "file_type": "concept", "source_file": ".agents/skills/expo-data-fetching/references/expo-router-loaders.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "StatusError from expo-server produces HTTP error responses from a loader and setResponseHeaders sets cache-control or similar headers, both supplied by expo-server which is already a dependency of expo-router."}], "edges": [{"source": "agents_skills_expo_data_fetching_references_expo_router_loaders", "target": "agents_skills_expo_data_fetching_references_expo_router_loaders_expo_router_data_loaders", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/expo-data-fetching/references/expo-router-loaders.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_expo_data_fetching_references_expo_router_loaders", "target": "agents_skills_expo_data_fetching_references_expo_router_loaders_loader_function_type", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/expo-data-fetching/references/expo-router-loaders.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_expo_data_fetching_references_expo_router_loaders", "target": "agents_skills_expo_data_fetching_references_expo_router_loaders_server_vs_static_output", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/expo-data-fetching/references/expo-router-loaders.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_expo_data_fetching_references_expo_router_loaders", "target": "agents_skills_expo_data_fetching_references_expo_router_loaders_suspense_and_error_boundary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/expo-data-fetching/references/expo-router-loaders.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_expo_data_fetching_references_expo_router_loaders", "target": "agents_skills_expo_data_fetching_references_expo_router_loaders_loader_server_side_secrets", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/expo-data-fetching/references/