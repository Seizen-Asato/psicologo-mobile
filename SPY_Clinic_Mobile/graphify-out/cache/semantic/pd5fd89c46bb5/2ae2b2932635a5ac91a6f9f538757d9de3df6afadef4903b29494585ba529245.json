{"nodes": [{"id": "agents_skills_react_best_practices_rules_rerender_move_effect_to_event_put_interaction_logic_in_event_handlers", "label": "Put Interaction Logic in Event Handlers", "file_type": "rationale", "source_file": ".agents/skills/react-best-practices/rules/rerender-move-effect-to-event.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A side effect caused by a specific user action should run in that action's handler. Modeling the action as state plus an effect makes the effect re-run on unrelated dependency changes and can duplicate the side effect."}, {"id": "agents_skills_react_best_practices_rules_rerender_move_effect_to_event_form", "label": "Form", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/rerender-move-effect-to-event.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_rerender_move_effect_to_event_handlesubmit", "label": "handleSubmit", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/rerender-move-effect-to-event.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_rerender_move_effect_to_event_post", "label": "post", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/rerender-move-effect-to-event.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules_rerender_move_effect_to_event_showtoast", "label": "showToast", "file_type": "code", "source_file": ".agents/skills/react-best-practices/rules/rerender-move-effect-to-event.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_react_best_practices_rules