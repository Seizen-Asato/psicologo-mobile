{"nodes": [{"id": "agents_skills_typescript_advanced_types_skill", "label": "TypeScript Advanced Types Skill", "file_type": "document", "source_file": ".agents/skills/typescript-advanced-types/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_typescript_advanced_types_skill_generics", "label": "Generics", "file_type": "concept", "source_file": ".agents/skills/typescript-advanced-types/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_typescript_advanced_types_skill_generic_constraints", "label": "Generic Constraints", "file_type": "concept", "source_file": ".agents/skills/typescript-advanced-types/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_typescript_advanced_types_skill_conditional_types", "label": "Conditional Types", "file_type": "concept", "source_file": ".agents/skills/typescript-advanced-types/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_typescript_advanced_types_skill_mapped_types", "label": "Mapped Types", "file_type": "concept", "source_file": ".agents/skills/typescript-advanced-types/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_typescript_advanced_types_skill_key_remapping", "label": "Mapped Type Key Remapping", "file_type": "concept", "source_file": ".agents/skills/typescript-advanced-types/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_typescript_advanced_types_skill_template_literal_types", "label": "Template Literal Types", "file_type": "concept", "source_file": ".agents/skills/typescript-advanced-types/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_typescript_advanced_types_skill_utility_types", "label": "Utility Types", "file_type": "concept", "source_file": ".agents/skills/typescript-advanced-types/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_skills_typescript_advanced_types_skill_best_practices", "label": "TypeScript Best Practices", "file_type": "rationale", "source_file": ".agents/skills/typescript-advanced-types/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer unknown over any to keep type checking enforceable, interface for object shapes because it yields better error messages, type for unions and complex types, type guards instead of type assertions, const assertions to preserve literal types, strict compiler options, and JSDoc on complex types so intent survives the compiler."}, {"id": "agents_skills_typescript_advanced_types_skill_type_testing", "label": "Type Testing (AssertEqual / ExpectError)", "file_type": "concept", "source_file": ".agents/skills/typescript-advanced-types/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Type-level assertions such as AssertEqual and the ExpectError helper let the compiler itself verify type behaviour, so a type regression fails the build instead of surfacing later as a runtime bug."}, {"id": "agents_skills_typescript_advanced_types_skill_common_pitfalls", "label": "Common TypeScript Pitfalls", "file_type": "concept", "source_file": ".agents/skills/typescript-advanced-types/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Over-using any and ignoring strict null checks defeat the purpose of TypeScript and cause runtime errors, while skipping discriminated unions forfeits narrowing and forgetting readonly modifiers permits unintended mutations; overly complex types also slow compilation and circular references break it outright."}, {"id": "agents_skills_typescript_advanced_types_skill_performance_considerations", "label": "TypeScript Performance Considerations", "file_type": "concept", "source_file": ".agents/skills/typescript-advanced-types/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deeply nested conditional types and unbounded recursive types slow the compiler, so complex type computations must be cached, recursion depth limited, and simple types preferred."}], "edges": [{"source": "agents_skills_typescript_advanced_types_skill", "target": "agents_skills_typescript_advanced_types_skill_generics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/typescript-advanced-types/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_typescript_advanced_types_skill_generics", "target": "agents_skills_typescript_advanced_types_skill_generic_constraints", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/typescript-advanced-types/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_typescript_advanced_types_skill", "target": "agents_skills_typescript_advanced_types_skill_conditional_types", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/typescript-advanced-types/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agents_skills_typescript_advanced_types_skill", "target": "agents_skills_typescript_advanced_types_skill_mapped_types", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/typescript-advanced-types/SKILL.md", "s